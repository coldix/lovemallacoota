---
/*
  The three ways to put money behind the site. Prices are stated in full, and
  so is what they are not: Love Mallacoota is not registered for GST and is not
  a deductible gift recipient, so nobody should reach the payment page expecting
  a tax invoice with GST on it or a deduction at tax time.
*/
interface Props {
  heading?: string;
  lede?: string;
}
const {
  heading = "Keeping this going",
  lede = "The site is free to read and free to be listed in, and it costs something to run. Three ways to help, none of them obligatory.",
} = Astro.props;

const options = [
  {
    href: "/donate",
    kicker: "One-off",
    title: "Chip in",
    body: "Whatever you think it is worth. Covers hosting, the domains and the archive scanning - and supports the Mallacoota 2020 video channel.",
    cta: "Donate",
    tone: "btn-coral",
  },
  {
    href: "/subscribe",
    kicker: "$10 a month",
    title: "Community supporter",
    body: "Ongoing support for the weekly edition, local guides, photography, the archive and the Mallacoota 2020 videos. Cancel whenever you like.",
    cta: "Become a supporter",
    tone: "btn-primary",
  },
  {
    href: "/advertise",
    kicker: "$35 a month",
    title: "Local business listing",
    body: "Being listed in the directory is free and always will be. This is advertising: a featured placement and your advertisement in the weekly edition, in print and on the web.",
    cta: "Book a spot",
    tone: "btn-ghost",
  },
];
---

<section class="glass-card sheen content-block reveal" aria-labelledby="support-title">
  <h2 id="support-title" class="section-title">{heading}</h2>
  <p class="section-sub">{lede}</p>

  <div class="support-grid">
    {options.map((option) => (
      <article class="support-card">
        <p class="support-kicker">{option.kicker}</p>
        <h3>{option.title}</h3>
        <p>{option.body}</p>
        <a class={`btn ${option.tone}`} href={option.href}>{option.cta}</a>
      </article>
    ))}
  </div>

  <p class="edition-source support-note">
    Payments are handled by Stripe; no card details reach this site.
    <strong>Being listed in the directory is free</strong> - the $35 is for advertising, not for a listing.
    Love Mallacoota is <strong>not registered for GST</strong>, so no GST is charged and what you pay is the whole amount.
    A business advertising here can normally claim it as a business expense; for everyone else this is not
    tax deductible, because we are not a registered charity.
    Colin Dixon, sole trader, ABN 68 758 286 944.
    Questions: <a href="/contact.html?subject=support">ask us</a>.
  </p>

  <p class="edition-source support-note">
    Prefer to support the videos directly? Subscribe to
    <a href="https://www.youtube.com/@mallacoota2020" rel="noopener noreferrer" target="_blank">@mallacoota2020</a> on YouTube - it costs nothing and it helps.
  </p>

</section>
