---
import {
  articleAnchor,
  countArticles,
  editionPdfPath,
  editionTitle,
  sectionsWithContent,
  tableOfContents,
} from "../lib/editions.mjs";

interface Props {
  edition: Record<string, any>;
  /** Past editions are read-only and say so. */
  archived?: boolean;
}
const { edition, archived = false } = Astro.props;

const sections = sectionsWithContent(edition);

const DAY = new Intl.DateTimeFormat("en-AU", { weekday: "short", day: "numeric", month: "short", timeZone: "Australia/Melbourne" });
const dayName = (iso) => DAY.format(new Date(`${iso}T00:00:00+10:00`));

const TIDE_WHEN = new Intl.DateTimeFormat("en-AU", {
  weekday: "short", day: "numeric", month: "short",
  hour: "numeric", minute: "2-digit", hour12: true,
  timeZone: "Australia/Melbourne",
});
const tideWhen = (value) => TIDE_WHEN.format(new Date(value));
const toc = tableOfContents(edition);
const total = countArticles(edition);
const statusLabel =
  edition.status === "open"
    ? "Open — contributions for this week are still being accepted"
    : edition.status === "frozen"
      ? "Closed — this week's edition is complete"
      : "Published";
---

<section class="glass-card sheen content-block reveal edition-masthead">
  <p class="eyebrow">{editionTitle(edition)}</p>
  <h2 class="section-title">
    {total > 0
      ? `${total} ${total === 1 ? "item" : "items"} this week`
      : "This week so far"}
  </h2>
  <p class="section-sub">{statusLabel}</p>
  <div class="edition-actions">
    <a class="btn btn-primary" href={editionPdfPath(edition)}>Download the PDF</a>
    <button class="btn btn-ghost" type="button" data-print-edition>Print this edition</button>
  </div>
  {edition.status === "open" && (
    <p class="edition-pdf-pending">
      The PDF is the week so far — it is complete once the week closes.
    </p>
  )}
</section>

{toc.length > 0 && (
  <nav class="glass-card sheen content-block reveal edition-toc" aria-labelledby="edition-toc-title">
    <h2 id="edition-toc-title" class="section-title">In this edition</h2>
    <ol class="edition-toc-list">
      {toc.map((section) => (
        <li>
          <a class="edition-toc-section" href={`#section-${section.id}`}>{section.title}</a>
          <ul>
            {section.entries.map((entry) => (
              <li>
                <a href={`#${entry.id}`}>{entry.title}</a>
                {entry.byline && <span class="edition-toc-byline">{entry.byline}</span>}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </nav>
)}

{total === 0 && (
  <section class="glass-card sheen content-block reveal edition-web-only">
    <p class="no-results">
      Nothing has been contributed to this week yet — the forecast and features
      below are compiled automatically.
    </p>
  </section>
)}

{sections.length > 0 && (
  <section class="glass-card sheen content-block reveal edition-web-only" aria-label="Sponsored">
    <div class="ad-row-wrap"><div class="ad-row"><div class="ad-slot ad-300x250" data-ad-zone="in-content"></div><div class="ad-slot ad-300x250 ad-col-2" data-ad-zone="in-content-2"></div><div class="ad-slot ad-300x250 ad-col-3" data-ad-zone="in-content-3"></div></div></div>
  </section>
)}

{sections.map((section) => (
  <section class="glass-card sheen content-block reveal" id={`section-${section.id}`} aria-labelledby={`heading-${section.id}`}>
    <h2 class="section-title" id={`heading-${section.id}`}>{section.title}</h2>
    {section.auto?.type === "weather" && (
      <div class="edition-auto">
        <table class="forecast">
          <thead>
            <tr><th scope="col">Day</th><th scope="col">Forecast</th><th scope="col">Min</th><th scope="col">Max</th><th scope="col">Rain</th></tr>
          </thead>
          <tbody>
            {section.auto.data.days.map((day) => (
              <tr>
                <th scope="row">{dayName(day.date)}</th>
                <td>{day.summary}</td>
                <td>{Math.round(day.minC)}°</td>
                <td>{Math.round(day.maxC)}°</td>
                <td>{day.rainMm > 0 ? `${day.rainMm} mm` : "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="edition-source">
          Forecast from <a href={section.auto.data.sourceUrl} rel="noopener noreferrer" target="_blank">{section.auto.data.source}</a>, {section.auto.data.licence}. Not an official warning service — see <a href="/emergency.html">emergency information</a>.
        </p>
      </div>
    )}

    {section.auto?.type === "tides" && (
      <div class="edition-auto">
        <p>{section.auto.data.note}</p>
        <p><a class="btn btn-ghost" href={section.auto.data.url} rel="noopener noreferrer" target="_blank">{section.auto.data.label}</a></p>
      </div>
    )}

    {section.auto?.type === "tide-table" && (
      <div class="edition-auto">
        <table class="forecast">
          <thead>
            <tr><th scope="col">When</th><th scope="col">Tide</th><th scope="col">Height</th></tr>
          </thead>
          <tbody>
            {section.auto.data.extremes.map((extreme) => (
              <tr>
                <th scope="row">{tideWhen(extreme.time)}</th>
                <td>{extreme.type === "High" ? "High" : "Low"}</td>
                <td>{extreme.heightM.toFixed(2)} m</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="edition-source">
          Predictions from <a href={section.auto.data.sourceUrl} rel="noopener noreferrer" target="_blank">{section.auto.data.source}</a> for {section.auto.data.station}, datum {section.auto.data.datum}. Predictions only — they do not account for wind or barometric pressure, and the bar can differ from the tide. Check conditions before crossing.
        </p>
      </div>
    )}

    {section.auto?.type === "diary" && (
      <ul class="edition-diary">
        {section.auto.data.map((event) => (
          <li>
            <span class="edition-diary-when">{event.date}{event.time ? ` · ${event.time}` : ""}</span>
            <strong>{event.title}</strong>
            {event.location && <span class="edition-diary-where">{event.location}</span>}
          </li>
        ))}
      </ul>
    )}

    {section.auto?.type === "trail" && (
      <div class="edition-auto edition-feature">
        {section.auto.data.photo && (
          <img class="edition-photo" src={section.auto.data.photo} alt={section.auto.data.name} loading="lazy" decoding="async" />
        )}
        <h3>{section.auto.data.name}</h3>
        <p class="edition-feature-meta">
          {[section.auto.data.distance, section.auto.data.duration, section.auto.data.difficulty].filter(Boolean).join(" · ")}
        </p>
        <p>{section.auto.data.region}{section.auto.data.start ? ` — starts at ${section.auto.data.start}` : ""}.</p>
        {section.auto.data.summary && <p>{section.auto.data.summary}</p>}
        <p>
          <a class="btn btn-primary" href={section.auto.data.url} rel="noopener noreferrer" target="_blank">Full notes on TrailBound</a>
        </p>
        <p class="edition-source">
          Walk {section.auto.data.rotation.position} of {section.auto.data.rotation.of} within about two hours of Mallacoota. A different one each week.
        </p>
      </div>
    )}

    {section.auto?.type === "links" && (
      <div class="edition-link-grid">
        {section.auto.data.map((item) => (
          <div class="edition-link-card">
            <h4>
              {item.url
                ? <a href={item.url} rel="noopener noreferrer" target={item.url.startsWith("http") ? "_blank" : undefined}>{item.title}</a>
                : item.title}
            </h4>
            {item.description && <p>{item.description}</p>}
            {item.meta && <span class="meta">{item.meta}</span>}
          </div>
        ))}
      </div>
    )}

    {section.auto?.type === "business" && (
      <div class="edition-auto edition-feature">
        <h3>{section.auto.data.name}</h3>
        {section.auto.data.category && <p class="edition-feature-meta">{section.auto.data.category}{section.auto.data.locality ? ` · ${section.auto.data.locality}` : ""}</p>}
        <p>{section.auto.data.description}</p>
        <p>
          {section.auto.data.url && (
            <a class="btn btn-primary" href={section.auto.data.url} rel="noopener noreferrer" target="_blank">Visit</a>
          )}
          <a class="btn btn-ghost" href="/food.html">More in the directory</a>
        </p>
        <p class="edition-source">
          Chosen in turn from the {section.auto.data.rotation.of} listings in the directory — number {section.auto.data.rotation.position}. Not paid placement.
        </p>
      </div>
    )}

    {section.articles.map((article) => (
      <article class="edition-article" id={articleAnchor(article)}>
        <h3>{article.title}</h3>
        {article.byline && <p class="edition-byline">{article.byline}</p>}
        {(article.body || []).map((paragraph) => <p>{paragraph}</p>)}
      </article>
    ))}
  </section>
))}

{!archived && (
  <section class="glass-card sheen content-block reveal edition-web-only">
    <h2 class="section-title">Contribute</h2>
    <p class="section-sub">
      Notices, club news, school reports and community updates are welcome from the
      people and groups they belong to.
    </p>
    <div class="edition-actions">
      <a class="btn btn-coral" href="/contact.html?subject=edition">Ask about contributing</a>
      <a class="btn btn-ghost" href="/editorial-policy.html">What we publish</a>
    </div>
  </section>
)}
