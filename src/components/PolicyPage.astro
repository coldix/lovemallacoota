---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import PageHero from "./PageHero.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  prefix: string;
  accent: string;
  lede: string;
  /** Set where the page belongs in the navigation, if it does. */
  active?: string;
  /** Share card, where a page has one of its own. */
  socialImage?: string;
  /** The trail's last step, so the reader can see where the page sits. */
  crumb?: string;
  /** Passed through: the emergency page carries no survey banner. */
  showSurvey?: boolean;
}
const props = Astro.props;
const crumb = props.crumb || `${props.prefix} ${props.accent}`;
---
<BaseLayout
  title={props.title}
  description={props.description}
  canonicalPath={props.canonicalPath}
  active={props.active || ""}
  socialImage={props.socialImage}
  showSurvey={props.showSurvey ?? true}
>
  <PageHero prefix={props.prefix} accent={props.accent} lede={props.lede} />
  <main>
    <Breadcrumbs trail={[{ name: crumb, path: props.canonicalPath }]} />
    <article class="glass-card sheen content-block policy-content reveal"><slot /></article>
  </main>
</BaseLayout>
