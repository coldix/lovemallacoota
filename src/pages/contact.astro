---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { loadDataFile } from "../lib/editions.mjs";

// The same list the weekly edition uses, so the two cannot drift apart.
const social = loadDataFile("social-links.json", []);
const socialLinks = Array.isArray(social) ? social : social.links || [];

// Cloudflare's always-passes test key, so local builds work before the real
// widget exists. Set PUBLIC_TURNSTILE_SITE_KEY for preview and production.
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "1x00000000000000000000AA";
---
<BaseLayout title="Suggest an Update — Love Mallacoota" description="Suggest a new Mallacoota listing or correct information in the Love Mallacoota directory." canonicalPath="/contact.html" active="contact">
  <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <PageHero prefix="Suggest an" accent="Update" lede="See something wrong? Want to add a link? Let us know — it keeps the directory accurate for everyone." />
  <main>
    <section class="glass-card sheen content-block reveal">
      <form id="contact-form" class="form-grid" method="post" action="/api/submit">
        <div class="field full"><label for="business">Business or organisation</label><input id="business" name="business" type="text" required /></div>
        <div class="field"><label for="reason">Reason for contact</label><select id="reason" name="reason"><option>Add or update a link</option><option>Incorrect information</option><option>Business has closed</option><option>Suggest a new listing</option><option>Archive contribution</option><option>Other</option></select></div>
        <div class="field"><label for="url">URL (if any)</label><input id="url" name="url" type="url" placeholder="https://..." /></div>
        <div class="field full"><label for="notes">Notes</label><textarea id="notes" name="notes" rows="4" placeholder="Tell us what needs adding or correcting"></textarea></div>
        <div class="field"><label for="user_name">Your name</label><input id="user_name" name="user_name" type="text" required /></div>
        <div class="field"><label for="user_email">Your email</label><input id="user_email" name="user_email" type="email" required /></div>
        <div class="field full"><label for="user_phone">Your phone (optional)</label><input id="user_phone" name="user_phone" type="tel" /></div>
        <input type="hidden" id="from_page" name="from_page" value="" />
        <div class="field visually-hidden" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="field full"><div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div></div>
        <div class="form-actions full"><button class="btn btn-primary" type="submit" id="submit-btn">Send Update</button><a href="/" class="btn btn-ghost">Back to Home</a></div>
      </form>
      <p id="contact-hint" class="contact-hint"></p>
      <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
    </section>

    <section class="glass-card sheen content-block reveal" aria-labelledby="social-title">
      <h2 id="social-title" class="section-title">Where the town talks</h2>
      <p class="section-sub">
        Mallacoota does much of its talking on Facebook. These are the groups we
        point people to, and what each is for.
      </p>
      <div class="edition-link-grid">
        {socialLinks.map((link) => (
          <div class="edition-link-card">
            <h4><a href={link.url} rel="noopener noreferrer" target="_blank">{link.title}</a></h4>
            {link.description && <p>{link.description}</p>}
            {link.meta && <span class="meta">{link.meta}</span>}
          </div>
        ))}
      </div>

      <div class="social-suggest">
        <h3>Know one we have missed?</h3>
        <p>
          Clubs, sporting groups, the school, church notices, markets, arts,
          fishing, fire and emergency pages — if there is a page the town
          actually uses and it is not here, tell us and we will add it.
        </p>
        <p class="social-rule">
          <strong>Public pages and groups only.</strong> We do not list private,
          closed or invitation-only groups. A link is only worth printing if
          anyone reading it can follow it, and a directory that sends people to
          doors they cannot open is worse than no directory. If a group is
          public but asks new members a question or two, that is fine.
        </p>
        <p>
          <a class="btn btn-coral" href="/contact.html?subject=social">Suggest a page or group</a>
        </p>
      </div>
    </section>
  </main>
  <script slot="scripts" is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const contactForm = document.getElementById("contact-form");
      const submitBtn = document.getElementById("submit-btn");
      const statusMsg = document.getElementById("form-status");
      if (!contactForm || !submitBtn || !statusMsg) return;

      const params = new URLSearchParams(location.search);
      const business = document.getElementById("business");
      const hint = document.getElementById("contact-hint");
      const subject = params.get("subject");
      business.value =
        params.get("business") ||
        (subject === "archive"
          ? "Mallacoota Mouth archive"
          : subject === "newsletter"
            ? "Newsletter interest"
            : subject === "social"
              ? "Facebook page or group to add"
              : subject === "edition"
                ? "The weekly edition"
                : subject === "local"
                  ? "Local of the Week suggestion"
                  : "");
      const from = params.get("from");
      if (from) {
        hint.textContent = `Submitted from: ${from}`;
        document.getElementById("from_page").value = from;
      }

      contactForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
        statusMsg.className = "form-status";
        statusMsg.textContent = "";

        try {
          const response = await fetch("/api/submit", {
            method: "POST",
            body: new FormData(contactForm),
          });
          const result = await response.json().catch(() => ({}));
          if (response.ok && result.ok) {
            statusMsg.textContent = "Thanks! Your update has been sent.";
            statusMsg.className = "form-status success";
            contactForm.reset();
            window.turnstile?.reset();
          } else {
            statusMsg.textContent =
              result.error || "Something went wrong. Please try again.";
            statusMsg.className = "form-status error";
            window.turnstile?.reset();
          }
        } catch {
          statusMsg.textContent = "Something went wrong. Please try again.";
          statusMsg.className = "form-status error";
          window.turnstile?.reset();
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = "Send Update";
        }
      });
    });
  </script>
</BaseLayout>
