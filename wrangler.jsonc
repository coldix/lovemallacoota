{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lovemallacoota",
  "account_id": "ab29454df8dbb469d259956fcf482075",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "lovemallacoota.au",
      "custom_domain": true
    },
    {
      "pattern": "www.lovemallacoota.au",
      "custom_domain": true
    }
  ],
  "env": {
    "preview": {
      "name": "lovemallacoota-preview",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "CONTACT_TO": "crdixon@gmail.com",
        "CONTACT_FROM": "forms@lovemallacoota.au"
      },
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [
        {
          "name": "CONTACT_RATE",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    }
  },
  "vars": {
    "CONTACT_TO": "crdixon@gmail.com",
    "CONTACT_FROM": "forms@lovemallacoota.au"
  },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    {
      "name": "CONTACT_RATE",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
