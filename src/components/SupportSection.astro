---
/*
  Two ways to help, and one thing to buy - kept apart on purpose. Asking for
  support and selling advertising are different conversations, and a business
  deciding whether to advertise should not have to read it as charity.

  Donations name their amounts: /donate?amount=20 opens a Stripe page that
  already says A$20.00, rather than a field to work out. The worker maps each
  amount to its own Stripe link, and anyone who wants a figure of their own
  falls back to the open link, which suggests A$25 and lets them change it.

  Every amount is a plain link to that payment link, and stays one if the
  script below does not run, if Stripe.js does not load, or if the Worker has
  no keys yet. When it does run the same click opens the form here instead, in
  a dialog over the page, so nobody is sent to a stranger's website holding
  their card.

  Prices are stated in full, and so is what they are not: Love Mallacoota is
  not registered for GST and is not a deductible gift recipient, so nobody
  should reach the payment page expecting GST on an invoice or a deduction at
  tax time. That belongs near the money, but not on top of it.
*/
interface Props {
  heading?: string;
  lede?: string;
}
const {
  heading = "Keeping this going",
  lede = "The site is free to read and free to be listed in, and it costs something to run. None of this is obligatory.",
} = Astro.props;

// Publishable, so it belongs in the page. Without it the dialog never opens and
// the buttons behave as they did before.
const stripeKey = import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY || "";

/** Kept in step with DONATE_PRESETS in src/worker.ts. */
const amounts = [10, 20, 50, 100];
---

<section class="glass-card sheen content-block reveal" aria-labelledby="support-title">
  <h2 id="support-title" class="section-title">{heading}</h2>
  <p class="section-sub">{lede}</p>

  <div class="support-grid">
    <article class="support-card">
      <p class="support-kicker">Any amount, once</p>
      <h3>Chip in</h3>
      <p>
        Whatever you think it is worth. Covers hosting, the domains and the archive
        scanning - and supports the Mallacoota 2020 video channel.
      </p>
      <div class="support-amounts">
        {amounts.map((amount) => (
          <a class="support-amount" href={`/donate?amount=${amount}`} data-donate={String(amount)}>${amount}</a>
        ))}
      </div>
      <p class="support-amount-hint">
        Tap an amount and Stripe opens ready to pay, or
        <a class="support-amount-other" href="/donate" data-donate="open">give another amount</a>.
      </p>
    </article>

    <article class="support-card">
      <p class="support-kicker">$10 a month</p>
      <h3>Community supporter</h3>
      <p>
        Ongoing support for the weekly edition, local guides, photography, the archive
        and the Mallacoota 2020 videos. Cancel whenever you like.
      </p>
      <a class="btn btn-primary" href="/subscribe">Become a supporter</a>
    </article>
  </div>

  <aside class="support-ad" aria-labelledby="support-ad-title">
    <p class="support-kicker">$35 a month</p>
    <h3 id="support-ad-title">Advertise your business</h3>
    <p>
      A featured placement and your advertisement in the weekly edition, in print and
      on the web. <strong>Being listed in the directory is free and always will be</strong> -
      this is advertising, not a listing fee.
    </p>
    <a class="btn btn-ghost" href="/advertise">Book a spot</a>
  </aside>

  <p class="edition-source support-note">
    Payments are handled by Stripe; no card details reach this site.
  </p>

  <details class="support-legal support-note">
    <summary>Tax, GST and who runs this</summary>
    <p>
      Love Mallacoota is <strong>not registered for GST</strong>, so no GST is charged and
      what you pay is the whole amount. A business advertising here can normally claim it
      as a business expense; for everyone else this is not tax deductible, because we are
      not a registered charity. Colin Dixon, sole trader, ABN 68 758 286 944.
      Questions: <a href="/contact.html?subject=support">ask us</a>.
    </p>
  </details>

  <p class="edition-source support-note">
    Prefer to support the videos directly? Subscribe to
    <a href="https://www.youtube.com/@mallacoota2020" rel="noopener noreferrer" target="_blank">@mallacoota2020</a> on YouTube - it costs nothing and it helps.
  </p>

  <dialog class="donate-dialog" id="donate-dialog" aria-label="Donate to Love Mallacoota">
    <div class="donate-dialog-head">
      <p class="support-kicker">Donate to lovemallacoota.au</p>
      <button type="button" class="donate-dialog-close" data-donate-close aria-label="Close">&times;</button>
    </div>
    <div class="donate-dialog-body" id="donate-mount"></div>
    <p class="donate-dialog-note">Handled by Stripe. No card details reach this site.</p>
  </dialog>

</section>

{stripeKey && (
  <script is:inline define:vars={{ stripeKey }}>
    /*
      The donate buttons are links, and stay links: every failure here leaves
      the click to the browser, which lands on the Stripe payment link the
      href already points at. Nothing below is required for somebody to give
      money - it only saves them the trip.
    */
    (() => {
      const dialog = document.getElementById("donate-dialog");
      const mount = document.getElementById("donate-mount");
      if (!dialog || !mount || typeof dialog.showModal !== "function") return;

      let stripeLoading = null;
      let checkout = null;

      function loadStripe() {
        if (stripeLoading) return stripeLoading;
        stripeLoading = new Promise((resolve, reject) => {
          if (window.Stripe) return resolve(window.Stripe(stripeKey));
          const script = document.createElement("script");
          script.src = "https://js.stripe.com/v3";
          script.onload = () => (window.Stripe ? resolve(window.Stripe(stripeKey)) : reject());
          script.onerror = reject;
          document.head.appendChild(script);
        });
        return stripeLoading;
      }

      async function open(amount) {
        const stripe = await loadStripe();
        const response = await fetch("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(amount === "open" ? {} : { amount }),
        });
        if (!response.ok) throw new Error("checkout unavailable");
        const { clientSecret } = await response.json();
        if (!clientSecret) throw new Error("no client secret");

        // One dialog, reopened. Leaving the old form mounted stacks a second
        // iframe behind the first, and the reader pays into whichever one
        // happens to be on top.
        if (checkout) checkout.destroy();
        checkout = await stripe.initEmbeddedCheckout({ clientSecret });
        checkout.mount("#donate-mount");
        dialog.showModal();
      }

      for (const link of document.querySelectorAll("[data-donate]")) {
        link.addEventListener("click", (event) => {
          // A modified click is a deliberate new tab or window; leave it alone.
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
          event.preventDefault();
          open(link.dataset.donate).catch(() => {
            window.location.href = link.href;
          });
        });
      }

      function close() {
        dialog.close();
        if (checkout) {
          checkout.destroy();
          checkout = null;
        }
      }

      dialog.querySelector("[data-donate-close]")?.addEventListener("click", close);
      dialog.addEventListener("close", () => {
        if (checkout) {
          checkout.destroy();
          checkout = null;
        }
      });
      // A click on the backdrop lands on the dialog itself, never on its
      // contents.
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) close();
      });
    })();
  </script>
)}
