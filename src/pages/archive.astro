---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import {
  archiveIssues,
  archiveSchema,
  archiveYears,
  issueSearchText,
  loadArchive,
} from "../lib/archive.mjs";
import {
  articleAnchor,
  editionLabel,
  editionPath,
  editionTitle,
  loadEditions,
  localsOfTheWeek,
} from "../lib/editions.mjs";
import { CARDS } from "../lib/social.mjs";
import { versioned } from "../lib/asset-version.mjs";

// Rendered here, at build time: 37 issues of unique local history that were
// previously fetched by the browser and therefore invisible to crawlers.
const archive = loadArchive();
const issues = archiveIssues(archive);
const years = archiveYears(issues);
const schema = archiveSchema(issues, archive);

// The weekly editions and the Local of the Week profiles are indexed here
// rather than on a page of their own. /locals.html used to republish the
// profiles in full beside the edition that already carried them; this is an
// index into that edition, and each row keeps the anchor the old page used so
// links shared before the change still land on the right story.
const editions = loadEditions();
const locals = localsOfTheWeek(editions);
---
<BaseLayout
  title="Mallacoota Mouth archive — every issue catalogued"
  description={`${issues.length} issues of The Mallacoota Mouth catalogued by date, issue number and contents, with past weekly editions and every Local of the Week profile.`}
  canonicalPath="/archive.html"
  active="archive"
  extraScript={versioned("/assets/js/archive.js")}
  socialImage={CARDS.archive}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  <PageHero eyebrow="Community history" prefix="Mallacoota Mouth" accent="Archive" lede="A growing, searchable record of the local newsletter that documented Mallacoota's people, organisations, events and everyday life — with the weekly editions and local profiles published since." />
  <main>
    <Breadcrumbs trail={[{ name: "Archive", path: "/archive.html" }]} />

    {/* Featured Feature: Love of Mallacoota Collection */}
    <section class="glass-card sheen content-block reveal" style="border: 1px solid var(--accent); background: linear-gradient(135deg, rgba(36,200,232,0.12), rgba(15,23,42,0.6));">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 999px; background: rgba(36,200,232,0.2); color: var(--accent); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem;">
            Featured Collection
          </span>
          <h2 class="section-title" style="margin: 0 0 0.5rem;">Love of Mallacoota (1998)</h2>
          <p class="section-sub" style="max-width: 680px; margin-bottom: 1.25rem;">
            Compiled by <strong>Edna J. Brady</strong> — A 100+ page regional history collection featuring coastal bush poetry by Henry Lawson, E.J. Brady, Louis Esson, and Ted Harrington, along with early selector maps, lighthouse memoirs, and historical photos.
          </p>
        </div>
      </div>
      <div class="edition-actions">
        <a class="btn btn-coral" href="/brady.html">Open Love of Mallacoota Archive &amp; PDF Reader →</a>
        <a class="btn btn-primary" href="https://loveofmallacoota.com/" target="_blank" rel="noopener noreferrer">Visit Love of Mallacoota Website</a>
        <a class="btn btn-ghost" href="/pdf/Love-of-Mallacoota.pdf" target="_blank" rel="noopener noreferrer">Download Original PDF (3.3 MB)</a>
      </div>
    </section>

    <section class="glass-card sheen content-block reveal archive-intro">
      <h2 class="section-title">Help recover the collection</h2>
      <p class="section-sub">We are starting with a handful of digital copies and hope to locate a near-complete run. Original files and clean scans are especially useful.</p>
      <div class="archive-principles">
        <article><strong>Preserve</strong><span>Keep a verified master file and checksum for every issue.</span></article>
        <article><strong>Index</strong><span>Search by date, issue number, organisation, person and topic.</span></article>
        <article><strong>Respect</strong><span>Record provenance and reuse status before publishing each copy.</span></article>
      </div>
      <div class="archive-contribute"><p>Have old editions or know who holds a larger collection?</p><a class="btn btn-coral" href="/contact.html?subject=archive">Contact the archive project</a></div>
    </section>
    {locals.length > 0 && (
      <section class="glass-card sheen content-block reveal" aria-labelledby="archive-locals-title" id="locals">
        <h2 id="archive-locals-title" class="section-title">Local of the Week</h2>
        <p class="section-sub">
          Every profile we have published, and the edition it appeared in. The
          stories stay where they were written rather than being copied to a
          page of their own.
        </p>
        <ul class="edition-index">
          {locals.map((local) => (
            <li id={articleAnchor(local)}>
              <a href={`${editionPath({ week: local.week })}#${articleAnchor(local)}`}>{local.title}</a>
              <span>Week of {local.displayDate}{local.byline ? ` · ${local.byline}` : ""}</span>
            </li>
          ))}
        </ul>
        <p class="section-sub">
          <a href="/contact.html?subject=local">Suggest someone worth writing about</a>.
        </p>
      </section>
    )}

    {editions.length > 0 && (
      <section class="glass-card sheen content-block reveal" aria-labelledby="archive-editions-title" id="editions">
        <h2 id="archive-editions-title" class="section-title">Weekly editions</h2>
        <p class="section-sub">Every week keeps a permanent page and a printable PDF.</p>
        <ul class="edition-index">
          {editions.map((edition) => (
            <li>
              <a href={editionPath(edition)}>{editionTitle(edition)}</a>
              <span>{editionLabel(edition)} · {(edition.articles || []).length} items</span>
            </li>
          ))}
        </ul>
        <p class="section-sub"><a href="/edition.html">Read this week's edition</a>.</p>
      </section>
    )}

    <section class="glass-card sheen content-block reveal" aria-labelledby="archive-catalogue-title">
      <h2 id="archive-catalogue-title" class="section-title">Issue catalogue</h2>
      <p class="section-sub">Search by issue, date, cover, or the headings pulled from each edition, and narrow the list to a single year.</p>
      <p class="archive-rights-note">Before any issue is made downloadable we are establishing whether <em>The Mallacoota Mouth</em> is in the public domain or whether permission is required, and from whom. Until that is settled and recorded, the catalogue lists what we hold but no PDF is published. <strong>If you know who holds the rights, or you were involved in producing the Mouth, please <a href="/contact.html?subject=archive">get in touch</a>.</strong></p>
      <div class="filter-bar">
        <div class="search-wrap"><span aria-hidden="true">⌕</span><input type="search" id="archive-search" class="search-input" placeholder="Search issue, date or topic…" aria-label="Search archived issues" autocomplete="off" /></div>
        <div class="tag-row" id="archive-years" role="group" aria-label="Filter by year">
          <button type="button" class="tag-btn active" data-year="All">All years</button>
          {years.map((entry) => (
            <button type="button" class="tag-btn" data-year={entry.year}>{entry.year} ({entry.count})</button>
          ))}
        </div>
        <p class="result-count" id="archive-count" aria-live="polite">
          {issues.length} {issues.length === 1 ? "issue" : "issues"} found
        </p>
      </div>
      <div id="archive-grid" class="archive-grid">
        {issues.map((issue) => (
          <article
            class="archive-card"
            data-year={String(issue.publicationDate).slice(0, 4)}
            data-search={issueSearchText(issue)}
          >
            <div class="archive-card-heading">
              <p class="archive-publication">{issue.publication}</p>
              <span class="archive-issue-number">Issue {issue.issueNumber}</span>
            </div>
            <h3>{issue.displayDate}</h3>
            <p class="archive-description">{issue.description}</p>
            {issue.cover?.caption && (
              <p class="archive-cover">
                <strong>{issue.cover.credit ? `Cover (${issue.cover.credit}): ` : "Cover: "}</strong>
                {issue.cover.caption}
              </p>
            )}
            <dl class="archive-metadata">
              <dt>Pages</dt><dd>{issue.pageCount}</dd>
              <dt>Editor</dt><dd>{issue.editor || "Not recorded"}</dd>
              <dt>Source</dt><dd>{issue.provenance || "Not recorded"}</dd>
            </dl>
            {(issue.contents || []).length > 0 && (
              <details class="archive-toc">
                <summary>In this issue ({issue.contents.length})</summary>
                <ol>
                  {issue.contents.map((entry) => (
                    <li><span class="archive-toc-page">p{entry.page}</span>{entry.title}</li>
                  ))}
                </ol>
              </details>
            )}
            <div class="chips archive-topics">
              {(issue.topics || []).map((topic) => <span class="chip">{topic}</span>)}
            </div>
            <div class="archive-availability">
              {issue.pdfUrl
                ? <a class="btn btn-primary" href={issue.pdfUrl}>Read issue (PDF)</a>
                : <span class="archive-status">Catalogued · digital copy under archive review</span>}
            </div>
          </article>
        ))}
      </div>
      <p class="no-results" id="archive-empty" hidden>No archived issues match that search.</p>
    </section>
  </main>
</BaseLayout>
