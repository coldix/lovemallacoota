---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";

interface ExploreLink { href: string; emoji: string; title: string; text: string }
interface Props {
  active: string;
  title: string;
  description: string;
  canonicalPath: string;
  prefix: string;
  accent: string;
  lede: string;
  placeholder: string;
  searchLabel: string;
  explore: ExploreLink[];
}
const props = Astro.props;
---

<BaseLayout title={props.title} description={props.description} canonicalPath={props.canonicalPath} active={props.active}>
  <PageHero prefix={props.prefix} accent={props.accent} lede={props.lede} />
  <main>
    <section class="glass-card sheen content-block reveal">
      <div class="filter-bar">
        <div class="search-wrap">
          <span aria-hidden="true">⌕</span>
          <input type="search" id="listing-search" class="search-input" placeholder={props.placeholder} aria-label={props.searchLabel} />
        </div>
        <div class="tag-row" id="tag-row" role="group" aria-label="Filter by category"></div>
        <p class="result-count" id="result-count" aria-live="polite"></p>
      </div>
      <div id="listings-grid" class="listings-grid"></div>
    </section>
    <section class="glass-card sheen content-block reveal">
      <h2 class="section-title">Keep Exploring</h2>
      <div class="links-grid">
        {props.explore.map((item) => (
          <a href={item.href} class="link-card">
            <span class="arrow" aria-hidden="true">↗</span>
            <span class="emoji" aria-hidden="true">{item.emoji}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
