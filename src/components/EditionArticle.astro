---
/*
# Project:     lovemallacoota.au
# Timestamp:   25/09/2026 03:30 AM AEST (Mallacoota)
# Version:     [26.09.001]
# File Name:   EditionArticle.astro
# Description: One contributed piece: headline, byline, audio, photographs,
#              body, corrections and contact. Shared by the whole issue
#              (EditionBody) and each story's own page, so the two cannot
#              drift apart.
*/
import { articleAnchor, imageSize } from "../lib/editions.mjs";
import { renderBody } from "../lib/markup.mjs";

interface Props {
  article: Record<string, any>;
  /** The story's own page. Linked from the headline area on the whole issue. */
  storyHref?: string;
  /** On its own page the headline is the page's h1. */
  standalone?: boolean;
}
const { article, storyHref, standalone = false } = Astro.props;
const Headline = standalone ? "h1" : "h3";

const isPoem = article.format === "poem";
/* The first picture leads the piece; any others sit in a grid beneath
   it. Every picture is a link to itself, so it opens larger with or
   without script; the lightbox in script.js takes over when it can. */
const pictures = [article.image, ...(article.images || [])].filter(Boolean);
/* One picture sits in the text column. Several go in one grid, the
   first marked as the lead: full width on screen, one cell of the
   grid on paper, where a lone picture in column one left column two
   empty beside it. */
const gallery =
  pictures.length > 1 || pictures.some((image) => image.display === "wide" || image.display === "full")
    ? pictures
    : [];
const lead = gallery.length === 0 ? pictures[0] || null : null;
/* Three or more full portraits stack so none is cropped. Two is a pair:
   an original and its reconstruction, or two portraits of the same
   people, sit side by side on screen and in print. */
const stacked = gallery.length > 2 && gallery.every((image) => image.display === "full");
const pair =
  gallery.length === 2 &&
  !stacked &&
  !gallery.some((image) => image.display === "wide");
const captionOf = (image) => [image.credit, image.caption || image.note].filter(Boolean);
---
<article class:list={["edition-article", { "edition-poem": isPoem, "edition-article-standalone": standalone }]} id={articleAnchor(article)}>
  {/* Headline and byline are kept outside the columns so print can hold
      them together with the first lines of the story. */}
  <header class="edition-article-head">
    <Headline>{article.title}</Headline>
    {article.byline && <p class="edition-byline">{article.byline}</p>}
    {storyHref && (
      <p class="edition-story-link edition-web-only"><a href={storyHref}>Open this story on its own page</a></p>
    )}
    {article.audio && (
      <div class="edition-audio-block" style="margin: 0.85rem 0 1.25rem; padding: 0.75rem 1rem; border-radius: 12px; background: rgba(36,200,232,0.08); border: 1px solid var(--glass-border);">
        <p style="margin: 0 0 0.4rem; font-size: 0.85rem; font-weight: 600; color: var(--accent); display: flex; align-items: center; gap: 0.4rem;">
          <span aria-hidden="true">🎧</span> {article.audio.title || "Listen to audio narration"}
        </p>
        <audio controls preload="none" style="width: 100%; height: 38px; border-radius: 999px;">
          <source src={article.audio.url} type="audio/mpeg" />
          Your browser does not support the audio element.
        </audio>
      </div>
    )}
  </header>
  {/* The pictures sit between the headline and the columns. As the first
      child of the column container, a full-width grid made Chromium
      push the whole piece to a fresh page whenever it started mid-page. */}
  {gallery.length > 0 && (
    <div class:list={["edition-figures-grid", { pair, stack: stacked }]}>
      {gallery.map((image, index) => (
        <figure class:list={["edition-figure", { lead: image.display === "wide" || (index === 0 && gallery.length > 2 && image.display !== "full" && image.display !== "small"), small: image.display === "small", wide: image.display === "wide", full: image.display === "full", qr: image.kind === "qr" }]}>
          <a class="edition-zoom" href={image.url} aria-label={`Enlarge: ${image.alt || article.title}`}>
            <img src={image.url} alt={image.alt} width={imageSize(image.url)?.width} height={imageSize(image.url)?.height} loading="eager" decoding="async" />
          </a>
          {captionOf(image).length > 0 && (
            <figcaption>
              {captionOf(image)[0]}
              {captionOf(image)[1] && <span> · {captionOf(image)[1]}</span>}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  )}
  <div class="edition-article-columns">
    {lead && (
      <figure class:list={["edition-figure", "lead", { small: lead.display === "small", wide: lead.display === "wide", full: lead.display === "full", qr: lead.kind === "qr" }]}>
        <a class="edition-zoom" href={lead.url} aria-label={`Enlarge: ${lead.alt || article.title}`}>
          <img src={lead.url} alt={lead.alt} width={imageSize(lead.url)?.width} height={imageSize(lead.url)?.height} loading="eager" decoding="async" />
        </a>
        {captionOf(lead).length > 0 && (
          <figcaption>
            {captionOf(lead)[0]}
            {captionOf(lead)[1] && <span> · {captionOf(lead)[1]}</span>}
          </figcaption>
        )}
      </figure>
    )}
    <div class:list={["edition-article-body", { "poem-body": isPoem }]}>
      <Fragment set:html={renderBody(article.body, isPoem)} />
    </div>
  </div>
  {article.corrections?.length > 0 && (
    <aside class="edition-correction">
      <h4>Corrections</h4>
      <ul>
        {article.corrections.map((correction) => (
          <li><time datetime={correction.date}>{correction.date}</time> - {correction.note}</li>
        ))}
      </ul>
    </aside>
  )}
  {article.contact?.public && (
    <p class="edition-source">
      Contact: <a href={`mailto:${article.contact.email}`}>{article.contact.email}</a>
      {article.contact.phone && <span> · {article.contact.phone}</span>}
    </p>
  )}
</article>
