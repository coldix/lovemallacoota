{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lovemallacoota",
  "account_id": "ab29454df8dbb469d259956fcf482075",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "lovemallacoota.au",
      "custom_domain": true
    },
    {
      "pattern": "www.lovemallacoota.au",
      "custom_domain": true
    }
  ],
  "env": {
    "preview": {
      "name": "lovemallacoota-preview",
      "workers_dev": true,
      "routes": [],
      "vars": {
        // The From on a verification code. Its domain must be verified with the
        // sending provider, or every code is refused.
        "MAIL_FROM": "Love Mallacoota <noreply@lovemallacoota.au>",
        "RELAY_URL": "https://ads.oze.net.au/relay",
        "STRIPE_LINK_DONATE": "https://buy.stripe.com/7sYaEXcVMaj8dbb2T777O0c",
        "STRIPE_LINK_SUBSCRIBE": "https://buy.stripe.com/eVq8wP1d48b06MN3Xb77O0b",
        "STRIPE_LINK_ADVERTISE": "https://buy.stripe.com/bJefZh8Fw4YOb332T777O0a"
      },
      "browser": { "binding": "BROWSER" },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lovemallacoota-directory",
          "database_id": "505a9643-4558-4a8b-bf39-8252ffc743d8",
          "migrations_dir": "./migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "CONTACT_RATE",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "LISTING_RATE",
          "namespace_id": "1002",
          "simple": { "limit": 8, "period": 60 }
        }
      ]
    }
  },
  "vars": {
    // The From on a verification code. Its domain must be verified with the
    // sending provider, or every code is refused.
    "MAIL_FROM": "Love Mallacoota <noreply@lovemallacoota.au>",
    "RELAY_URL": "https://ads.oze.net.au/relay",
    "STRIPE_LINK_DONATE": "https://buy.stripe.com/7sYaEXcVMaj8dbb2T777O0c",
    "STRIPE_LINK_SUBSCRIBE": "https://buy.stripe.com/eVq8wP1d48b06MN3Xb77O0b",
    "STRIPE_LINK_ADVERTISE": "https://buy.stripe.com/bJefZh8Fw4YOb332T777O0a"
  },
  "browser": { "binding": "BROWSER" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lovemallacoota-directory",
      "database_id": "505a9643-4558-4a8b-bf39-8252ffc743d8",
      "migrations_dir": "./migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "LISTING_RATE",
      "namespace_id": "1002",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
