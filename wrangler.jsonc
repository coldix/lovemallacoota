{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lovemallacoota",
  "account_id": "ab29454df8dbb469d259956fcf482075",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "lovemallacoota.au",
      "custom_domain": true
    },
    {
      "pattern": "www.lovemallacoota.au",
      "custom_domain": true
    },
    // Legacy hostnames. src/worker.ts answers each with a 301 to lovemallacoota.au.
    {
      "pattern": "lovemallacoota.com.au",
      "custom_domain": true
    },
    {
      "pattern": "www.lovemallacoota.com.au",
      "custom_domain": true
    },
    {
      "pattern": "lovemallacoota.com",
      "custom_domain": true
    },
    {
      "pattern": "www.lovemallacoota.com",
      "custom_domain": true
    }
  ],
  "env": {
    "preview": {
      "name": "lovemallacoota-preview",
      "workers_dev": true,
      "routes": [],
      "vars": {
        // oze.com.au is the domain verified with Resend. lovemallacoota.au is a
        // Google Workspace alias onto it, not a sending domain, and Resend
        // refuses a From on it.
        "MAIL_FROM": "Love Mallacoota <coota@oze.com.au>",
        "RELAY_URL": "https://ads.oze.net.au/relay",
        "STRIPE_LINK_DONATE": "https://buy.stripe.com/7sYaEXcVMaj8dbb2T777O0c",
        "STRIPE_LINK_SUBSCRIBE": "https://buy.stripe.com/eVq8wP1d48b06MN3Xb77O0b",
        "STRIPE_LINK_ADVERTISE": "https://buy.stripe.com/bJefZh8Fw4YOb332T777O0a"
      },
      "browser": { "binding": "BROWSER" },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lovemallacoota-directory",
          "database_id": "505a9643-4558-4a8b-bf39-8252ffc743d8",
          "migrations_dir": "./migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "CONTACT_RATE",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "LISTING_RATE",
          "namespace_id": "1002",
          "simple": { "limit": 8, "period": 60 }
        }
      ]
    }
  },
  "vars": {
    // oze.com.au is the domain verified with Resend. lovemallacoota.au is a
    // Google Workspace alias onto it, not a sending domain, and Resend
    // refuses a From on it.
    "MAIL_FROM": "Love Mallacoota <coota@oze.com.au>",
    "RELAY_URL": "https://ads.oze.net.au/relay",
    "STRIPE_LINK_DONATE": "https://buy.stripe.com/7sYaEXcVMaj8dbb2T777O0c",
    "STRIPE_LINK_SUBSCRIBE": "https://buy.stripe.com/eVq8wP1d48b06MN3Xb77O0b",
    "STRIPE_LINK_ADVERTISE": "https://buy.stripe.com/bJefZh8Fw4YOb332T777O0a"

    // One link per offered donation amount, so /donate?amount=25 opens ready to
    // pay rather than at A$0.00 with the amount behind a pencil icon. Add each
    // one as it is created in Stripe; an amount with no link here falls back to
    // STRIPE_LINK_DONATE, so the buttons work in the meantime. Mirror any of
    // these into env.preview.vars above when previewing the flow.
    // "STRIPE_LINK_DONATE_5": "https://buy.stripe.com/…",
    // "STRIPE_LINK_DONATE_10": "https://buy.stripe.com/…",
    // "STRIPE_LINK_DONATE_25": "https://buy.stripe.com/…",
    // "STRIPE_LINK_DONATE_50": "https://buy.stripe.com/…",

    // The plink_… ids behind those buttons, so a payment is filed by what it was
    // for rather than by its amount (see classifyPayment in src/stripe-webhook.ts).
    // Without them a price rise silently refiles every payment.
    // "STRIPE_AD_PAYMENT_LINK": "plink_…",
    // "STRIPE_SUPPORTER_PAYMENT_LINK": "plink_…",
    // "STRIPE_DONATION_PAYMENT_LINKS": "plink_…,plink_…,plink_…"
  },
  "browser": { "binding": "BROWSER" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lovemallacoota-directory",
      "database_id": "505a9643-4558-4a8b-bf39-8252ffc743d8",
      "migrations_dir": "./migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "LISTING_RATE",
      "namespace_id": "1002",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
  // Do not set limits.cpu_ms. This account is on the Workers Free plan, and
  // Cloudflare rejects the whole deploy (code 100328). PDF rendering spends
  // its time waiting on Browser Rendering, not burning Worker CPU.
}
