---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import {
  archiveIssues,
  loadArchive,
} from "../lib/archive.mjs";
import {
  editionLabel,
  editionPath,
  editionTitle,
  isMonthly,
  loadEditions,
} from "../lib/editions.mjs";
import { CARDS } from "../lib/social.mjs";

const archive = loadArchive();
const issues = archiveIssues(archive);
const editions = loadEditions();
const monthlies = editions.filter(isMonthly);
const weeklies = editions.filter((edition) => !isMonthly(edition));
---
<BaseLayout
  title="Mallacoota Community History & Archive Hub"
  description="Historical archive hub for Mallacoota, featuring past editions of Coota and catalogued issues of The Mallacoota Mouth."
  canonicalPath="/archive.html"
  active="archive"
  socialImage={CARDS.archive}
>
  <PageHero
    eyebrow="Community history"
    prefix="Mallacoota"
    accent="Archive"
    lede="A growing record of regional history, historical publications, and local stories documenting Mallacoota's people, organisations, events and everyday life."
  />
  <main>
    <Breadcrumbs trail={[{ name: "Archive", path: "/archive.html" }]} />

    {/* Dedicated Mallacoota Mouth Back-Issues Feature Card */}
    <section class="glass-card sheen content-block reveal" style="border: 1px solid rgba(255,255,255,0.15);">
      <span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 999px; background: rgba(255,255,255,0.1); color: var(--text); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem;">
        Historical Publication
      </span>
      <h2 class="section-title" style="margin: 0 0 0.5rem;">The Mallacoota Mouth Back-Issue Catalogue</h2>
      <p class="section-sub" style="max-width: 720px; margin-bottom: 1.25rem;">
        {issues.length} historic issues of <em>The Mallacoota Mouth</em> catalogued by date, issue number, cover photographs, and contents. Search by issue, headline, or year.
      </p>
      <div class="edition-actions">
        <a class="btn btn-primary" href="/mouth.html">Explore Mallacoota Mouth Catalogue →</a>
        <a class="btn btn-ghost" href="/contact.html?subject=archive">Help Recover Missing Issues</a>
      </div>
    </section>

    {monthlies.length > 0 && (
      <section class="glass-card sheen content-block reveal" aria-labelledby="archive-coota-title" id="editions">
        <h2 id="archive-coota-title" class="section-title">Coota</h2>
        <p class="section-sub">The monthly edition grows through the month, then keeps a permanent page and a printable A4 PDF.</p>
        <ul class="edition-index">
          {monthlies.map((edition) => (
            <li>
              <a href={editionPath(edition)}>{editionTitle(edition)}</a>
              <span>{editionLabel(edition)} · {(edition.articles || []).length} items</span>
            </li>
          ))}
        </ul>
        <p class="section-sub"><a href="/edition.html">Read this month's Coota</a>.</p>
      </section>
    )}

    {weeklies.length > 0 && (
      <section class="glass-card sheen content-block reveal" aria-labelledby="archive-editions-title" id="weekly-editions">
        <h2 id="archive-editions-title" class="section-title">Weekly digital editions</h2>
        <p class="section-sub">The first weekly edition, before Coota became a monthly.</p>
        <ul class="edition-index">
          {weeklies.map((edition) => (
            <li>
              <a href={editionPath(edition)}>{editionTitle(edition)}</a>
              <span>{editionLabel(edition)} · {(edition.articles || []).length} items</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</BaseLayout>
