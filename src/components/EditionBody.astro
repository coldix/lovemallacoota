---
/*
# Timestamp:   25/09/2026 12:45 PM AEST (Mallacoota)
# Version:     [26.09.006]
# File Name:   EditionBody.astro
# Description: The whole issue: masthead, contents, sections and stories. On
#              screen the contents comes first and each story links to its
#              own page; print and the PDF are built from this same page.
*/
import {
  articleAnchor,
  articlesThisWeek,
  countArticles,
  editionLabel,
  editionPdfPath,
  editionTitle,
  isMonthly,
  sectionsWithContent,
  tableOfContents,
} from "../lib/editions.mjs";
import { adsForSection, busGroups, busPlace, fillerPhoto, fullPageAds, imageSize, socialForSection, storyPath, youTubeId } from "../lib/editions.mjs";
import EditionArticle from "./EditionArticle.astro";
import EditionCrossword from "./EditionCrossword.astro";
import WeekWeather from "./WeekWeather.astro";
import WeekTides from "./WeekTides.astro";

interface Props {
  edition: Record<string, any>;
  /** Past editions are read-only and say so. */
  archived?: boolean;
}
const { edition, archived = false } = Astro.props;

const sections = sectionsWithContent(edition);

const DAY = new Intl.DateTimeFormat("en-AU", { weekday: "short", day: "numeric", month: "short", timeZone: "Australia/Melbourne" });
/** A publication date wants the year and not the weekday. */
const PUBLISHED = new Intl.DateTimeFormat("en-AU", { day: "numeric", month: "long", year: "numeric", timeZone: "Australia/Melbourne" });
const publishedOn = (iso) => PUBLISHED.format(new Date(`${iso}T00:00:00+10:00`));
const dayName = (iso) => DAY.format(new Date(`${iso}T00:00:00+10:00`));

const TIDE_WHEN = new Intl.DateTimeFormat("en-AU", {
  weekday: "short", day: "numeric", month: "short",
  hour: "numeric", minute: "2-digit", hour12: true,
  timeZone: "Australia/Melbourne",
});
const tideWhen = (value) => TIDE_WHEN.format(new Date(value));
const toc = tableOfContents(edition);
const crossword = sections.find((section) => section.auto?.type === "crossword") || null;
const rawFiller = fillerPhoto(edition);
const isFillerUsed = edition.articles?.some(a => 
  a.image?.url === rawFiller?.url || a.images?.some(img => img.url === rawFiller?.url)
);
const filler = isFillerUsed ? null : rawFiller;
const total = countArticles(edition);
const monthly = isMonthly(edition);
const newThisWeek = monthly ? articlesThisWeek(edition) : [];
const statusLabel =
  edition.status === "open"
    ? monthly
      ? "Open - stories are still being added this month"
      : "Open - contributions for this week are still being accepted"
    : edition.status === "frozen"
      ? monthly
        ? "Closed - this month's edition is complete"
        : "Closed - this week's edition is complete"
      : "Published";
---

{edition.cover && (
  <>
    {/* Page one of the printed edition: the photograph, full bleed, with the
        masthead over it. Hidden on screen, where the hero already does this.
        The masthead is a <p>, not a heading: the page already has its h1 in
        the hero, and a second one told crawlers the page was about the word
        "Mallacoota" rather than about the week. */}
    <section class="edition-cover" aria-hidden="true">
      <img src={edition.cover.print || edition.cover.web} alt="" width={imageSize(edition.cover.print || edition.cover.web)?.width} height={imageSize(edition.cover.print || edition.cover.web)?.height} />
      <div class="edition-cover-mast">
        <p class="edition-cover-eyebrow">{monthly ? "Coota" : "This Week in"}</p>
        <p class="edition-cover-title">{monthly ? edition.displayDate : "Mallacoota"}</p>
        <p class="edition-cover-date">{editionTitle(edition)}</p>
        <p class="edition-cover-number">{editionLabel(edition)}</p>
      </div>
      {(edition.cover.caption || edition.cover.credit) && (
        <p class="edition-cover-caption">
          {edition.cover.caption}
          {edition.cover.credit && <span> - {edition.cover.credit}</span>}
        </p>
      )}
    </section>
  </>
)}

<section class="glass-card sheen content-block reveal edition-masthead">
  <p class="eyebrow">{editionTitle(edition)} · {editionLabel(edition)}</p>
  <h2 class="section-title">
    {total > 0
      ? `${total} ${total === 1 ? "item" : "items"} ${monthly ? "this month" : "this week"}`
      : monthly
        ? "This month so far"
        : "This week so far"}
  </h2>
  <p class="section-sub">{statusLabel}</p>
  <div class="edition-actions">
    <a class="btn btn-primary" href={editionPdfPath(edition)} download={`mallacoota-${edition.week}.pdf`}>Download the PDF</a>
    <button class="btn btn-ghost" type="button" data-print-edition>Print this edition</button>
    <a class="btn btn-ghost" href="/archive.html#editions">Past editions</a>
  </div>
  {edition.status === "open" && (
    <p class="edition-pdf-pending">
      {monthly
        ? `The PDF is the month so far - it is complete once ${edition.displayDate} closes.`
        : "The PDF is the week so far - it is complete once the week closes."}
    </p>
  )}
</section>

{/* Before the contents on screen, for the reader who was here last week.
    Not printed: the archive copy of a month has no "this week". [26.09.001] */}
{newThisWeek.length > 0 && (
  <section class="glass-card content-block edition-new edition-web-only" id="section-new-this-week" aria-labelledby="heading-new-this-week">
    <h2 class="section-title" id="heading-new-this-week">New this week</h2>
    <ul class="edition-diary">
      {newThisWeek.map((article) => (
        <li>
          <a href={`#${articleAnchor(article)}`}>{article.title}</a>
          {article.byline && <span> · {article.byline}</span>}
        </li>
      ))}
    </ul>
  </section>
)}

{toc.length > 0 && (
  <nav class="glass-card sheen content-block reveal edition-toc" id="contents" aria-labelledby="edition-toc-title">
    <h2 id="edition-toc-title" class="section-title">In this edition</h2>
    {/* The crossword prints on the last page, so on paper its entry is listed
        last too: hidden in print where it falls, and repeated for print at
        the end. The screen list is unchanged. [26.09.006] */}
    <ol class="edition-toc-list">
      {[
        ...toc.map((section) => ({ section, only: section.id === "crossword" ? "edition-web-only" : null })),
        ...toc.filter((section) => section.id === "crossword").map((section) => ({ section, only: "edition-print-only" })),
      ].map(({ section, only }) => (
        <li class:list={["edition-toc-group", only]}>
          <a class="edition-toc-section" href={`#section-${section.id}`}>{section.title}</a>
          <ul>
            {section.entries.map((entry) => (
              <li class="edition-toc-entry">
                <a href={`#${entry.id}`}>{entry.title}</a>
                {entry.byline && <span class="edition-toc-byline">{entry.byline}</span>}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </nav>
)}

{/* The cover photograph follows the contents on screen, so a phone reaches
    the stories without scrolling past a full-screen picture first. */}
{edition.cover && (
  <figure class="glass-card sheen content-block reveal edition-cover-web">
    <img src={edition.cover.web} alt={edition.cover.caption || "Cover photograph"} width={imageSize(edition.cover.web)?.width} height={imageSize(edition.cover.web)?.height} loading="eager" decoding="async" />
    {(edition.cover.caption || edition.cover.credit) && (
      <figcaption>
        {edition.cover.caption}
        {edition.cover.credit && <span> - {edition.cover.credit}</span>}
      </figcaption>
    )}
  </figure>
)}

{total === 0 && (
  <section class="glass-card sheen content-block reveal edition-web-only">
    <p class="no-results">
      {monthly
        ? "Nothing has been contributed this month yet - the crossword, forecast and features below are compiled automatically, and stories will appear here as they arrive."
        : "Nothing has been contributed to this week yet - the forecast and features below are compiled automatically."}
    </p>
  </section>
)}

{sections.length > 0 && (
  <section class="glass-card sheen content-block reveal edition-web-only" aria-label="Sponsored">
    <div class="ad-row-wrap"><div class="ad-row"><div class="ad-slot ad-300x250" data-ad-zone="in-content"></div><div class="ad-slot ad-300x250 ad-col-2" data-ad-zone="in-content-2"></div><div class="ad-slot ad-300x250 ad-col-3" data-ad-zone="in-content-3"></div></div></div>
  </section>
)}

{sections.map((section) => (
  <section class:list={["glass-card sheen content-block reveal", { "edition-web-only": section.id === "crossword" }]} id={`section-${section.id}`} aria-labelledby={`heading-${section.id}`}>
    <h2 class="section-title" id={`heading-${section.id}`}>{section.title}</h2>
    {section.auto?.type === "crossword" && (
      <EditionCrossword data={section.auto.data} />
    )}
    {section.auto?.type === "weather" && (
      <WeekWeather weather={section.auto.data} />
    )}

    {section.auto?.type === "video" && youTubeId(section.auto.data.url) && (
      <div class="edition-auto">
        <div class="media-frame edition-web-only">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${youTubeId(section.auto.data.url)}`}
            title={section.auto.data.title || "Video of the week"}
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
        <p class="edition-source">
          <a href={section.auto.data.url} rel="noopener noreferrer" target="_blank">Watch on YouTube</a>
          {section.auto.data.credit && <span> · {section.auto.data.credit}</span>}
          {section.auto.data.note && <span> · {section.auto.data.note}</span>}
        </p>
      </div>
    )}

    {(section.auto?.type === "tides" || section.auto?.type === "tide-table") && (
      <div class="edition-auto">
        <WeekTides tides={section.auto.type === "tide-table" ? section.auto.data : null} moon={section.auto.moon} />
      </div>
    )}

    {section.auto?.type === "diary" && (
      <>
        <ul class="edition-diary">
          {section.auto.data.map((event) => (
            <li>
              <span class="edition-diary-when">{event.date}{event.time ? ` · ${event.time}` : ""}</span>
              <strong>{event.title}</strong>
              {event.location && <span class="edition-diary-where">{event.location}</span>}
            </li>
          ))}
        </ul>
        <p class="edition-source">
          This week only. Everything further out, and the regular club meetings,
          are on <a href="/calendar.html">What's On</a>.
        </p>
      </>
    )}

    {section.auto?.type === "trail" && (
      <div class="edition-auto edition-feature">
        {section.auto.data.photo && (
          <img class="edition-photo" src={section.auto.data.photo} alt={section.auto.data.name} width={imageSize(section.auto.data.photo)?.width} height={imageSize(section.auto.data.photo)?.height} loading="eager" decoding="async" />
        )}
        <h3>{section.auto.data.name}</h3>
        <p class="edition-feature-meta">
          {[section.auto.data.distance, section.auto.data.duration, section.auto.data.difficulty].filter(Boolean).join(" · ")}
        </p>
        <p>{section.auto.data.region}{section.auto.data.start ? ` - starts at ${section.auto.data.start}` : ""}.</p>
        {section.auto.data.summary && <p>{section.auto.data.summary}</p>}
        <p>
          <a class="btn btn-primary" href={section.auto.data.url} rel="noopener noreferrer" target="_blank">Full notes on TrailBound</a>
        </p>
        <p class="edition-source">
          Walk {section.auto.data.rotation.position} of {section.auto.data.rotation.of} within about two hours of Mallacoota. A different one each week.
        </p>
      </div>
    )}

    {section.auto?.type === "timetable" && (() => {
      const bus = busGroups(section.auto.data.services);
      const tickets = section.auto.data.tickets;
      return (
      <div class="edition-auto">
        {section.auto.data.advice && <p class="bus-advice">{section.auto.data.advice}</p>}
        {tickets && (
          <p class="bus-tickets">
            Tickets from <a href={tickets.listing}>{tickets.where}</a>, {tickets.street}.
          </p>
        )}

        <h4 class="bus-heading">Through Genoa</h4>
        <ul class="bus-list">
          {bus.through.map((service) => (
            <li class="bus-service">
              <p class="bus-route">{busPlace(service.from)} to {busPlace(service.to)}</p>
              <p class="bus-when">
                <span class="bus-days">{service.days}</span>
                <span class="bus-times">{service.departures.join(", ")}</span>
              </p>
            </li>
          ))}
        </ul>

        <h4 class="bus-heading">
          Getting to Genoa
          {bus.connectionDays.length > 0 && <span class="bus-only">{bus.connectionDays.join(", ")} only</span>}
        </h4>
        <ul class="bus-list">
          {bus.connection.map((service) => (
            <li class="bus-service">
              <p class="bus-route">{busPlace(service.from)} to {busPlace(service.to)}</p>
              <p class="bus-when">
                <span class="bus-days">{service.days}</span>
                <span class="bus-times">{service.departures.join(", ")}</span>
              </p>
            </li>
          ))}
        </ul>

        <p class="bus-stops">
          The Mallacoota stop is at the Bendigo Bank on Maurice Avenue, Gipsy Point is on Gipsy Point Road, and Genoa is the Genoa Hotel on Alexanders Road.
        </p>
        <p class="edition-source">
          {section.auto.data.route}. Times from the <a href={section.auto.data.sourceUrl} rel="noopener noreferrer" target="_blank">{section.auto.data.source}</a>, {section.auto.data.licence}, valid {section.auto.data.validFrom} to {section.auto.data.validTo}. Coaches must be booked ahead; check before travelling.
        </p>
      </div>
      );
    })()}

    {section.auto?.type === "radio" && (
      <div class="edition-auto">
        {/* A day-by-day grid, not the bus from/to table: what matters is when a
            local show is on, and every hour between them is the same satellite
            feed. Listing that feed hour by hour would triple the height of the
            section on paper and say nothing. */}
        <div class="radio-week">
          {section.auto.data.days.map((day) => (
            <div class="radio-day">
              <h4>{day.day}</h4>
              <ul>
                {day.shows.map((show) => (
                  <li class:list={["radio-show", { postponed: Boolean(show.postponed) }]}>
                    <span class="radio-time">{show.time}</span>
                    <span class="radio-title">{show.title}</span>
                    {show.presenter && <span class="radio-presenter">{show.presenter}</span>}
                    {show.postponed && <span class="radio-note">{show.postponed}</span>}
                    {show.note && <span class="radio-note">{show.note}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="edition-source">
          Everything between these is the {section.auto.data.networkFiller}.
          Programme from <a href={section.auto.data.sourceUrl} rel="noopener noreferrer" target="_blank">{section.auto.data.source}</a> on 3mgb.org.au, the guide 3MGB published {publishedOn(section.auto.data.guideUpdated)}. {section.auto.data.caution} {section.auto.data.frequencies.map((f) => `${f.mhz} ${f.place}`).join(", ")}. Listen live at {section.auto.data.listen.join(", ")}, or ring the studio on {section.auto.data.phone}. This is 3MGB's programme, not ours - <a href={`/listing/${section.auto.data.listingSlug}.html`}>their listing</a>.
        </p>
      </div>
    )}

    {section.auto?.type === "links" && section.auto.intro && (
      <p class="section-sub">{section.auto.intro}</p>
    )}

    {section.auto?.type === "links" && (
      <div class="edition-link-grid">
        {section.auto.data.map((item) => (
          <div class="edition-link-card">
            <div class="edition-link-copy">
              <h4>
                {item.url
                  ? <a href={item.url} rel="noopener noreferrer" target={item.url.startsWith("http") ? "_blank" : undefined}>{item.title}</a>
                  : item.title}
              </h4>
              {item.description && <p>{item.description}</p>}
              {item.meta && <span class="meta">{item.meta}</span>}
              {item.verified && (
                <span class="meta verified-note">✓ {item.verifiedNote || "Verified"}</span>
              )}
            </div>
            {item.qr && (
              <img class="edition-qr" src={item.qr} alt={`QR code for ${item.title}`} width={imageSize(item.qr)?.width} height={imageSize(item.qr)?.height} loading="eager" decoding="async" />
            )}
          </div>
        ))}
      </div>
    )}

    {section.auto?.type === "links" && section.auto.invite && (
      <div class="social-suggest edition-web-only">
        <h3>{section.auto.invite.heading}</h3>
        <p>{section.auto.invite.body}</p>
        <p class="social-rule"><strong>{section.auto.invite.rule.split(".")[0]}.</strong>{section.auto.invite.rule.slice(section.auto.invite.rule.indexOf(".") + 1)}</p>
        <p><a class="btn btn-coral" href={section.auto.invite.url}>{section.auto.invite.label}</a></p>
      </div>
    )}

    {section.auto?.type === "business" && (
      <div class="edition-auto edition-feature">
        {section.auto.data.photo && (
          <img class="edition-photo" src={section.auto.data.photo} alt={section.auto.data.photoAlt || section.auto.data.name} width={imageSize(section.auto.data.photo)?.width} height={imageSize(section.auto.data.photo)?.height} loading="eager" decoding="async" />
        )}
        {section.auto.data.photoCredit && <p class="edition-feature-credit">Photograph: {section.auto.data.photoCredit}</p>}
        <h3>{section.auto.data.name}</h3>
        {section.auto.data.category && <p class="edition-feature-meta">{section.auto.data.category}{section.auto.data.locality ? ` · ${section.auto.data.locality}` : ""}</p>}
        <p>{section.auto.data.description}</p>
        <p>
          {section.auto.data.url && (
            <a class="btn btn-primary" href={section.auto.data.url} rel="noopener noreferrer" target="_blank">Visit</a>
          )}
          {/* Its own page, not the section a week's rotation happened to land in.
              This said "More in the directory" and went to Eat & Drink even when
              the business of the week was a caravan park. */}
          {section.auto.data.slug && (
            <a class="btn btn-coral edition-web-only" href={`/listing/${section.auto.data.slug}.html`}>Contact and details</a>
          )}
          <a class="btn btn-ghost" href="/directory.html">The whole directory</a>
        </p>
        {/* A hand-picked business has no rotation, and must not claim one. */}
        <p class="edition-source">
          {section.auto.data.rotation
            ? `Chosen in turn from the ${section.auto.data.rotation.of} listings in the directory - number ${section.auto.data.rotation.position}. Not paid placement.`
            : "Chosen by the editor this week, out of the usual rotation. Not paid placement."}
        </p>
      </div>
    )}

    {socialForSection(section.id) && (
      <p class="edition-source edition-web-only">
        Also on Facebook: <a href={socialForSection(section.id).url} rel="noopener noreferrer" target="_blank">{socialForSection(section.id).title}</a>.
      </p>
    )}

    {adsForSection(edition, section.id).map((ad) => (
      <aside class={`edition-ad edition-ad-${ad.size}`} aria-label="Advertisement">
        <p class="edition-ad-label">Advertisement</p>
        {ad.url
          ? <a href={ad.url} rel="noopener noreferrer" target="_blank"><img src={ad.image} alt={ad.alt || ad.advertiser} width={imageSize(ad.image)?.width} height={imageSize(ad.image)?.height} /></a>
          : <img src={ad.image} alt={ad.alt || ad.advertiser} width={imageSize(ad.image)?.width} height={imageSize(ad.image)?.height} />}
        {ad.advertiser && <p class="edition-ad-by">{ad.advertiser}</p>}
      </aside>
    ))}

    {section.articles.map((article) => (
      <EditionArticle article={article} storyHref={storyPath(edition, article)} />
    ))}

    <p class="edition-back edition-web-only"><a href="#contents">Back to contents</a></p>
  </section>
))}

{fullPageAds(edition).map((ad) => (
  <aside class="edition-ad edition-ad-full" aria-label="Advertisement">
    <p class="edition-ad-label">Advertisement</p>
    {ad.url
      ? <a href={ad.url} rel="noopener noreferrer" target="_blank"><img src={ad.image} alt={ad.alt || ad.advertiser} width={imageSize(ad.image)?.width} height={imageSize(ad.image)?.height} /></a>
      : <img src={ad.image} alt={ad.alt || ad.advertiser} width={imageSize(ad.image)?.width} height={imageSize(ad.image)?.height} />}
    {ad.advertiser && <p class="edition-ad-by">{ad.advertiser}</p>}
  </aside>
))}

{filler && (
  <section class="glass-card sheen content-block reveal edition-filler">
    <figure class="edition-figure">
      <img src={filler.url} alt={filler.alt} width={imageSize(filler.url)?.width} height={imageSize(filler.url)?.height} loading="eager" decoding="async" />
      <figcaption>{filler.caption}{filler.credit && <span> - {filler.credit}</span>}</figcaption>
    </figure>
  </section>
)}

{!archived && (
  <section class="glass-card sheen content-block reveal edition-web-only">
    <h2 class="section-title">Contribute</h2>
    <p class="section-sub">
      Notices, club news, school reports and community updates are welcome from the
      people and groups they belong to.
    </p>
    <div class="edition-actions">
      {/* The contact route leads, because it works for everybody. Submitting
          directly needs a contributor account, and this button used to be the
          primary one - which sent people to a form that turned them away. */}
      <a class="btn btn-primary" href="/contact.html?subject=edition">Send us something for the edition</a>
      <a class="btn btn-ghost" href="/submit.html">Contributors: publish direct</a>
      <a class="btn btn-ghost" href="/editorial-policy.html">What we publish</a>
    </div>
  </section>
)}

{/* Always in reach on a long page. No script: it is a link. */}
{toc.length > 0 && (
  <a class="edition-fab edition-web-only" href="#contents" aria-label="Back to the contents">Contents</a>
)}

<footer class="edition-print-footer edition-print-only">
  <p>Love Mallacoota · lovemallacoota.au · Published {publishedOn(edition.monthStart || edition.weekStart)} · Documenting East Gippsland's coast, community & history with care.</p>
</footer>

{/* The crossword needs a page to itself. Mid-issue it jumped to the next
    page and left most of the one before it empty, so on paper it is the last
    page: this copy prints, the one in its place above does not. [26.09.006] */}
{crossword && (
  <section class="edition-print-only edition-crossword-print" aria-hidden="true">
    <h2 class="section-title">{crossword.title}</h2>
    <EditionCrossword data={crossword.auto.data} />
  </section>
)}
