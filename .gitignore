.dev.vars
.env
.env.*
!.env.example

# Local editor and OS state
.idea/
.vscode/
*.swp
*.tmp

# Native app workspace/user state is not part of the static website
*.xcuserstate
xcuserdata/

# Staged originals are committed by the Worker and removed by CI once
# converted; they are never part of the build.
!uploads/

# Local logs and generated scratch files
*.log
tmp/
