---
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import SurveyBanner from "../components/SurveyBanner.astro";
import { DEFAULT_CARD, OG_DIR, cardAlt } from "../lib/social.mjs";
import { versioned } from "../lib/asset-version.mjs";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  active?: string;
  robots?: string;
  extraScript?: string;
  showAds?: boolean;
  /** Page-specific 1200 x 630 share card; falls back to the home card. */
  socialImage?: string;
  /** Alternative text for the share card, where the default is not specific enough. */
  socialImageAlt?: string;
  /** "article" for editorial pages, "website" for everything else. */
  ogType?: string;
  /** The survey banner. Off where a reader has come for something urgent. */
  showSurvey?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  active = "",
  robots = "index,follow",
  extraScript,
  showAds = false,
  socialImage: socialImagePath,
  socialImageAlt,
  ogType = "website",
  showSurvey = true,
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const socialPath = socialImagePath || DEFAULT_CARD;
const socialImage = new URL(socialPath, Astro.site);
// Dimensions are declared only for the generated cards, whose size we know. A
// listing photograph is whatever the owner supplied, and guessing at it would
// make Facebook lay out a space the picture does not fill.
const isCard = socialPath.startsWith(`${OG_DIR}/`);
const socialAlt = socialImageAlt || cardAlt(title.split(" - ")[0]);
---

<!doctype html>
<html lang="en-AU" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Love Mallacoota" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {isCard && <meta property="og:image:width" content="1200" />}
    {isCard && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialAlt} />
    <meta name="geo.region" content="AU-VIC" />
    <meta name="geo.placename" content="Mallacoota" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/assets/icons/safari-pinned-tab.svg" color="#24c8e8" />
    <meta name="theme-color" content="#04101c" />
    <script is:inline>
      (() => {
        const theme = localStorage.getItem("theme") ||
          (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={versioned("/assets/css/style.css")} />
    {showAds && <link rel="stylesheet" href={versioned("/assets/css/adnet.css")} />}
    <script src={versioned("/assets/js/script.js")} defer></script>
    {extraScript && <script src={extraScript} defer></script>}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CPTXSP8D3J"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments)}
      gtag("js", new Date());
      gtag("config", "G-CPTXSP8D3J");
    </script>
    <slot name="head" />
  </head>
  <body data-page={active}>
    <div class="bg-field" aria-hidden="true"></div>
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="caustics" aria-hidden="true"></div>
    <canvas id="motes" class="motes" aria-hidden="true"></canvas>
    <SiteNav active={active} />
    <div class="page-wrapper">
      {showSurvey && <SurveyBanner />}
      <slot />
      <SiteFooter />
    </div>
    {showAds && <script async src="https://ads.oze.net.au/t.js"></script>}
    <slot name="scripts" />
  </body>
</html>
