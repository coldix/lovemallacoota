---
/*
 * The bar carries the two things the site is for — what is happening now
 * (This Week, What's On) and where to find things (Directory, and the three
 * shortcuts visitors actually arrive looking for). Everything else lives one
 * press away, with Emergency at the head of that menu rather than buried in it.
 *
 * The logo is Home. Spending a navigation slot on a Home link would cost a
 * shortcut and buy nothing.
 */
interface Props {
  active?: string;
}

const { active = "" } = Astro.props;

/** Shown in the bar on desktop, and at the top of the menu on narrow screens. */
const primary = [
  ["edition", "/edition.html", "This Week"],
  ["calendar", "/calendar.html", "What's On"],
  ["directory", "/directory.html", "Directory"],
  ["food", "/food.html", "Eat & Drink"],
  ["accom", "/accom.html", "Stay"],
  ["activity", "/activity.html", "Do & See"],
];

/**
 * The rest of the directory, then the reference pages. Grouped so the menu
 * reads as two short lists rather than one long one.
 */
const secondary = [
  { label: "More of the directory", items: [
    ["community", "/community.html", "Community"],
    ["services", "/services.html", "Services"],
    ["add-listing", "/add-listing.html", "Add your listing"],
    ["directory-changes", "/directory-changes.html", "What's new"],
  ] },
  { label: "Also here", items: [
    ["archive", "/archive.html", "Archive"],
    ["contact", "/contact.html", "Contact"],
  ] },
];

const secondaryKeys = secondary.flatMap((group) => group.items.map(([key]) => key));
const menuActive = secondaryKeys.includes(active) || active === "emergency";
---

<nav class="site-nav" aria-label="Main">
  <a href="/" class="nav-brand" aria-label="Love Mallacoota - home">
    <img src="/images/logo145x100.webp" alt="" width="145" height="100" />
    <span>Love Mallacoota</span>
  </a>
  <span class="nav-spacer"></span>
  <div class="nav-inline">
    {primary.map(([key, href, label]) => (
      <a
        href={href}
        class:list={["nav-link", { active: active === key }]}
        aria-current={active === key ? "page" : undefined}
      >
        {label}
      </a>
    ))}
  </div>
  <div class="nav-more">
    <button
      type="button"
      id="nav-menu-toggle"
      class:list={["nav-menu-toggle", { active: menuActive }]}
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Open the rest of the menu"
    >
      <span class="nav-menu-bars" aria-hidden="true"></span>
    </button>
    <div id="nav-menu" class="nav-menu" hidden>
      <div class="nav-menu-primary">
        {primary.map(([key, href, label]) => (
          <a href={href} class:list={[{ active: active === key }]} aria-current={active === key ? "page" : undefined}>
            {label}
          </a>
        ))}
      </div>
      {/* First in the menu, and marked, because somebody looking for it is not browsing. */}
      <a
        href="/emergency.html"
        class:list={["nav-menu-emergency", { active: active === "emergency" }]}
        aria-current={active === "emergency" ? "page" : undefined}
      >
        Emergency
      </a>
      {secondary.map((group) => (
        <div class="nav-menu-group">
          <p class="nav-menu-label">{group.label}</p>
          {group.items.map(([key, href, label]) => (
            <a href={href} class:list={[{ active: active === key }]} aria-current={active === key ? "page" : undefined}>
              {label}
            </a>
          ))}
        </div>
      ))}
    </div>
  </div>
  <button id="theme-toggle" class="theme-toggle" aria-pressed="false" aria-label="Toggle theme"></button>
</nav>
