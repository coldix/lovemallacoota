---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

/*
 * The id is NOT read here. This is a static build, so Astro.url is the URL at
 * build time, which has no query string — reading it here shipped
 * value="" on every copy of the page, the submission id never reached the
 * server, and the error blamed the code the person had just typed correctly.
 * It is filled from location.search at runtime, below.
 */
---
<BaseLayout
  title="Enter your code - Love Mallacoota"
  description="Enter the email code to confirm a Love Mallacoota directory listing."
  canonicalPath="/verify.html"
  robots="noindex,nofollow"
>
  <PageHero
    prefix="Check your"
    accent="Email"
    lede="We sent a six-digit code. It expires in 15 minutes. Unverified submissions are never published."
  />
  <main>
    <section class="glass-card sheen content-block reveal">
      <form id="verify-form" class="form-grid" method="post" action="/api/listing/verify">
        <input type="hidden" name="id" value="" />
        <div class="field full">
          <label for="code">Code</label>
          <input id="code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code" />
        </div>
        <div class="form-actions full">
          <button class="btn btn-primary" type="submit" id="submit-btn">Confirm</button>
        </div>
      </form>
      <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
    </section>
  </main>
  <script slot="scripts" is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("verify-form");
      const submitBtn = document.getElementById("submit-btn");
      const statusMsg = document.getElementById("form-status");

      // The page is static, so the id can only come from the address bar, and
      // only once the browser has it.
      const submissionId = new URLSearchParams(location.search).get("id") || "";
      form.elements.id.value = submissionId;
      if (!submissionId) {
        statusMsg.textContent =
          "This link is missing its submission. Open the link in the email we sent rather than typing the address.";
        statusMsg.className = "form-status error";
      }
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        submitBtn.disabled = true;
        try {
          const response = await fetch("/api/listing/verify", { method: "POST", body: new FormData(form) });
          const result = await response.json().catch(() => ({}));
          if (response.ok && result.ok) {
            statusMsg.textContent = result.message || "Confirmed.";
            statusMsg.className = "form-status success";
            if (result.manageUrl) location.href = result.manageUrl;
          } else {
            statusMsg.textContent = result.error || "That code did not work.";
            statusMsg.className = "form-status error";
          }
        } catch {
          statusMsg.textContent = "Something went wrong. Please try again.";
          statusMsg.className = "form-status error";
        } finally {
          submitBtn.disabled = false;
        }
      });
    });
  </script>
</BaseLayout>
