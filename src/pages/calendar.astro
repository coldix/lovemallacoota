---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageHero from "../components/PageHero.astro";
import { CARDS } from "../lib/social.mjs";
import WeekWeather from "../components/WeekWeather.astro";
import WeekTides from "../components/WeekTides.astro";
import { currentEdition, loadWeekly } from "../lib/editions.mjs";

const edition = currentEdition();
const weekly = edition ? loadWeekly(edition.week) : null;
import { loadDirectory, listingPagePath } from "../lib/directory.mjs";

const meetings = loadDirectory()
  .filter((entity) => entity.meetingTimes)
  .sort((a, b) => a.name.localeCompare(b.name));
---
<BaseLayout
  title="What's on in Mallacoota — events, markets and club nights"
  description={`The Mallacoota community calendar: markets, meetups, workshops and club nights, with ${meetings.length} regular meeting times from local clubs and groups.`}
  canonicalPath="/calendar.html"
  active="calendar"
  socialImage={CARDS.calendar}
>
  <PageHero prefix="What's" accent="On" lede="Markets, meetups, workshops and club nights — the community calendar, plus regular meetings from the directory." />
  <main>
    <Breadcrumbs trail={[{ name: "What's On", path: "/calendar.html" }]} />
    <section class="glass-card sheen content-block reveal">
      <div class="calendar-frame">
        <iframe
          title="Mallacoota Community Calendar"
          src="https://calendar.google.com/calendar/embed?mode=AGENDA&wkst=2&ctz=Australia%2FMelbourne&title=Love%20Mallacoota&src=Y3JkaXhvbkBnbWFpbC5jb20&color=%237986cb"
          loading="lazy"
        ></iframe>
      </div>
    </section>
    <section class="glass-card sheen content-block reveal">
      <h2 class="section-title">Something missing, or wrong?</h2>
      <p class="section-sub">
        The calendar is only as good as what people tell us. Send an event and
        it goes up; tell us something is wrong and we will fix it.
      </p>
      <div class="edition-actions">
        <a class="btn btn-primary" href="/submit-event.html">Add an event</a>
        <a class="btn btn-coral" href="/contact.html?subject=correction">Report a correction</a>
        <a class="btn btn-ghost" href="/corrections.html">How corrections work</a>
      </div>
    </section>

    {weekly?.weather && (
      <section class="glass-card sheen content-block reveal" aria-labelledby="calendar-weather">
        <h2 id="calendar-weather" class="section-title">This week's weather</h2>
        <WeekWeather weather={weekly.weather} />
      </section>
    )}

    {(weekly?.tides || weekly?.moon) && (
      <section class="glass-card sheen content-block reveal" aria-labelledby="calendar-tides">
        <h2 id="calendar-tides" class="section-title">Tides and the moon</h2>
        <div class="edition-auto">
          <WeekTides tides={weekly.tides} moon={weekly.moon} />
        </div>
      </section>
    )}

    <section class="glass-card sheen content-block reveal">
      <div class="links-grid">
        <a href="/edition.html" class="link-card">
          <span class="arrow" aria-hidden="true">↗</span>
          <span class="emoji" aria-hidden="true">📰</span>
          <h3>This Week</h3>
          <p>The weekly edition — notices, local stories, weather and classifieds.</p>
        </a>
        <a href="/directory.html" class="link-card">
          <span class="arrow" aria-hidden="true">↗</span>
          <span class="emoji" aria-hidden="true">📖</span>
          <h3>Directory</h3>
          <p>Every business, club and service, with contacts and meeting times.</p>
        </a>
        <div class="link-card">
          <span class="emoji" aria-hidden="true">📅</span>
          <h3>Take it with you</h3>
          <p>Use the “+ Google Calendar” button on the calendar to add these events to your own phone.</p>
        </div>
      </div>
    </section>
    {meetings.length > 0 && (
      <section class="glass-card sheen content-block reveal">
        <h2 class="section-title">Regular meetings</h2>
        <p class="section-sub">From claimed or confirmed directory listings. Clubs add their own times.</p>
        <ul class="edition-diary">
          {meetings.map((entity) => (
            <li>
              <span class="edition-diary-when">{entity.meetingTimes}</span>
              <a href={listingPagePath(entity)}>{entity.name}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</BaseLayout>
