---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import {
  canClaim,
  collectionSchema,
  displayTags,
  formatAddress,
  getPrimaryLink,
  getPrimaryLinkLabel,
  isOfficialEntity,
  listingPagePath,
  listingPhoto,
  mapLinks,
  photoAbsoluteUrl,
  searchText,
  sectionEntities,
  tagFilters,
  telHref,
  verificationLine,
} from "../lib/directory.mjs";
import { ENTITY_TYPES } from "../lib/directory-model.mjs";

interface ExploreLink { href: string; emoji: string; title: string; text: string }
interface Props {
  active: string;
  title: string;
  description: string;
  canonicalPath: string;
  prefix: string;
  accent: string;
  lede: string;
  placeholder: string;
  searchLabel: string;
  schemaName: string;
  section: string;
  noun?: string;
  explore: ExploreLink[];
}
const props = Astro.props;
const noun = props.noun || "listings";

const entities = sectionEntities(props.section);
const tags = tagFilters(entities);
const schema = collectionSchema(entities, props.schemaName, props.canonicalPath, (entity) =>
  photoAbsoluteUrl(entity)
);
---

<BaseLayout title={props.title} description={props.description} canonicalPath={props.canonicalPath} active={props.active} showAds={true}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  <PageHero prefix={props.prefix} accent={props.accent} lede={props.lede} />
  <main>
    <section class="glass-card sheen content-block reveal">
      <p class="directory-add-banner">
        <a class="btn btn-primary" href="/add-listing.html">Add your listing — free</a>
        <span>Clubs, trades, shops and services maintain their own information. Love Mallacoota checks it first.</span>
      </p>
      <div class="filter-bar">
        <div class="search-wrap">
          <span aria-hidden="true">⌕</span>
          <input type="search" id="listing-search" class="search-input" placeholder={props.placeholder} aria-label={props.searchLabel} />
        </div>
        <div class="tag-row" id="tag-row" role="group" aria-label="Filter by category">
          <button type="button" class="tag-btn active" data-tag="All">All</button>
          {tags.map((tag) => (
            <button type="button" class="tag-btn" data-tag={tag}>{tag}</button>
          ))}
        </div>
        <p class="result-count" id="result-count" aria-live="polite">
          Showing {entities.length} of {entities.length} {noun}
        </p>
      </div>
      <div id="listings-grid" class="listings-grid" data-total={entities.length} data-noun={noun}>
        {entities.map((entity) => {
          const primary = getPrimaryLink(entity);
          const primaryLabel = getPrimaryLinkLabel(entity);
          const address = formatAddress(entity.address);
          const chips = displayTags(entity);
          const photo = listingPhoto(entity);
          const verification = verificationLine(entity);
          const typeLabel = ENTITY_TYPES[entity.entityType]?.label;
          const official = isOfficialEntity(entity);
          const href = listingPagePath(entity);
          return (
            <article
              class:list={["listing-card", { official }]}
              data-tags={(entity.categories || []).join("|")}
              data-search={searchText(entity)}
              data-type={entity.entityType}
              data-letter={(entity.name.match(/[A-Za-z]/) || ["#"])[0].toUpperCase()}
            >
              {photo && (
                <a href={href}>
                  <img
                    class="listing-photo"
                    src={photo.url}
                    alt={photo.alt}
                    width="1280"
                    height="720"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
              <p class="listing-kicker">
                {official && <span class="listing-badge official">Official</span>}
                {typeLabel && <span class="listing-badge">{typeLabel}</span>}
              </p>
              <h3><a href={href}>{entity.name}</a></h3>
              {entity.commonName && entity.commonName !== entity.name && (
                <p class="listing-aka">Also known as {entity.commonName}</p>
              )}
              {chips.length > 0 && (
                <div class="chips">
                  {chips.map((tag) => <span class="chip">{tag}</span>)}
                </div>
              )}
              <p class="desc">
                {entity.descriptionShort || entity.description || "No description available."}
              </p>
              {entity.meetingTimes && <p class="addr">Meeting: {entity.meetingTimes}</p>}
              {address && <p class="addr">{address}</p>}
              {entity.serviceArea && !address && <p class="addr">Serves {entity.serviceArea}</p>}
              <p class:list={["listing-verified", { unverified: !verification.verified }]}>
                {verification.verified ? "✓ " : ""}{verification.text}
              </p>
              <div class="links">
                <a href={href}>Details</a>
                {primary
                  ? <a href={primary} target="_blank" rel="noopener noreferrer">{primaryLabel}</a>
                  : <button type="button" class="suggest-link" data-bname={entity.name}>Suggest link</button>}
                {mapLinks(entity).map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer">{link.text}</a>
                ))}
                {entity.phone && <a href={telHref(entity.phone)}>Call</a>}
                {entity.email && <a href={`mailto:${entity.email}`}>Email</a>}
                {canClaim(entity) && <a href={`/claim.html?slug=${entity.slug}`}>Claim</a>}
              </div>
            </article>
          );
        })}
      </div>
      <p class="no-results" id="no-results" hidden>No matches — try a different search or tag.</p>
    </section>
    <section class="glass-card sheen content-block reveal" aria-label="Sponsored">
      <div class="ad-row-wrap"><div class="ad-row"><div class="ad-slot ad-300x250" data-ad-zone="in-content"></div><div class="ad-slot ad-300x250 ad-col-2" data-ad-zone="in-content-2"></div><div class="ad-slot ad-300x250 ad-col-3" data-ad-zone="in-content-3"></div></div></div>
    </section>
    <section class="glass-card sheen content-block reveal">
      <h2 class="section-title">Keep Exploring</h2>
      <div class="links-grid">
        {props.explore.map((item) => (
          <a href={item.href} class="link-card">
            <span class="arrow" aria-hidden="true">↗</span>
            <span class="emoji" aria-hidden="true">{item.emoji}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
