# Public Turnstile site key for the contact form. Safe to commit a real one —
# it appears in the page source by design. Without it the build falls back to
# Cloudflare's always-passes test key, which is fine locally and wrong in
# production. CI reads the same value from the GitHub Actions secret of the
# same name.
PUBLIC_TURNSTILE_SITE_KEY=

# Publishable Stripe key for the donate form, which opens on the page rather
# than on Stripe's own site. Safe to commit a real one - it is in the page
# source by design. Without it the buttons stay ordinary links to the Stripe
# payment links, which is the fallback and always works. CI reads the same
# value from the GitHub Actions secret of the same name.
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secrets are not set here. They are Worker secrets:
#   npx wrangler secret put TURNSTILE_SECRET_KEY --env=""
#   npx wrangler secret put RELAY_KEY --env=""
#   npx wrangler secret put STRIPE_SECRET_KEY --env=""
