---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageHero from "../components/PageHero.astro";
import EditionBody from "../components/EditionBody.astro";
import {
  currentEdition,
  editionLabel,
  editionPath,
  editionSchema,
  editionSocialImage,
  editionTitle,
  isMonthly,
  loadEditions,
  pastEditions,
  publicationName,
  sectionsWithContent,
} from "../lib/editions.mjs";
import { CARDS } from "../lib/social.mjs";
import { clampMeta } from "../lib/meta.mjs";

const editions = loadEditions();
const edition = currentEdition(editions);
const past = pastEditions(editions);

const schema = edition ? editionSchema(edition) : null;

// The description names the week and what is actually in it, so the search
// result for "this week in Mallacoota" is not the same sentence every week.
const sectionNames = edition
  ? sectionsWithContent(edition)
      .map((section) => section.title)
      .slice(0, 5)
      .join(", ")
      .toLowerCase()
  : "";
const description = edition
  ? clampMeta(
      isMonthly(edition)
        ? `Coota ${edition.displayDate}: ${sectionNames || "the month so far"}. Stories are added as they arrive.`
        : `Mallacoota for the week of ${edition.displayDate}: ${sectionNames}. A new edition every week.`
    )
  : "Coota, the monthly Mallacoota edition - community notices, club and school news, events, weather and tides.";
---
<BaseLayout
  title={
    edition
      ? isMonthly(edition)
        ? `${editionLabel(edition)} - This month in Mallacoota`
        : `This Week in Mallacoota - ${editionLabel(edition)}`
      : "Coota"
  }
  description={description}
  canonicalPath="/edition.html"
  active="edition"
  showAds={true}
  ogType="article"
  socialImage={edition ? editionSocialImage(edition) : CARDS.edition}
>
  {schema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
  <PageHero
    eyebrow={edition && isMonthly(edition) ? editionLabel(edition) : "Weekly edition"}
    prefix={edition && isMonthly(edition) ? "Coota" : "This Week in"}
    accent={edition && isMonthly(edition) ? edition.displayDate : "Mallacoota"}
    lede={
      edition && isMonthly(edition)
        ? "This month in Mallacoota - stories, notices, the crossword, weather and what's on. The edition grows as pieces arrive, and closes as a PDF at the end of the month."
        : "Community notices, club and school news, the week's events, weather and tides - contributed by the people and groups they belong to."
    }
  >
    <div class="hero-cta">
      <a class="btn btn-coral" href="/submit.html">Submit an article or notice</a>
      <a class="btn btn-ghost" href="/archive.html#editions">Past editions archive</a>
    </div>
  </PageHero>
  <main>
    <Breadcrumbs trail={[{ name: edition && isMonthly(edition) ? "Coota" : "This Week", path: "/edition.html" }]} />
    {edition ? (
      <EditionBody edition={edition} />
    ) : (
      <section class="glass-card sheen content-block reveal">
        <p class="no-results">The first edition is still being put together.</p>
      </section>
    )}

    {past.length > 0 && (
      <section class="glass-card sheen content-block reveal">
        <h2 class="section-title">Past editions</h2>
        <p class="section-sub">
          Every week keeps its page. Older weeks, and every Local of the Week,
          are indexed in the <a href="/archive.html#editions">archive</a>.
        </p>
        <ul class="edition-index">
          {past.map((item) => (
            <li>
              <a href={editionPath(item)}>{editionTitle(item)}</a>
              <span>{editionLabel(item)} · {(item.articles || []).length} items</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</BaseLayout>
