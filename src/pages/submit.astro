---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { SECTIONS, currentEdition } from "../lib/editions.mjs";

const edition = currentEdition();
// Automatic sections are generated, so nobody submits into them.
const writable = SECTIONS.filter((section) => !section.automatic);
---
<BaseLayout
  title="Submit to this week's edition - Love Mallacoota"
  description="Approved contributors can add notices, club news, school reports and community updates to this week's edition."
  canonicalPath="/submit.html"
  active="submit"
  robots="noindex,nofollow"
>
  <PageHero eyebrow="Contributors" prefix="Submit to this" accent="Week" lede="Notices, club news, school reports, local history and profiles. Approved contributors publish straight through; anything the policy check queries is held for a person to read.">
    <div class="hero-cta">
      <a class="btn btn-ghost" href="/edition.html">← Back to this week's edition</a>
      <a class="btn btn-ghost" href="/editorial-policy.html">Editorial policy</a>
    </div>
  </PageHero>
  <main>
    {/* The edition links here with a prominent button, so most people arriving
        are not contributors and have no way to become one by clicking. Say so
        first, and give them a route that works, rather than letting them fill
        the form in and be turned away by the server. */}
    <section class="glass-card sheen content-block reveal">
      <h2 class="section-title">Submitting to the edition</h2>
      <p class="section-sub">
        Anyone is welcome to submit an article, notice, club report or photograph to the weekly edition.
      </p>
      <ul class="edition-diary">
        <li><strong>Signed-in contributors:</strong> If you are signed in, your submission is verified and published straight away upon passing policy check.</li>
        <li><strong>Guests / Non signed-in:</strong> You must supply both a <strong>contact email and phone number</strong>. Your piece will be reviewed and approved by an admin before going live.</li>
        <li><strong>Photographs:</strong> You may attach up to 3 photographs per piece. Each photo requires a credit.</li>
      </ul>
      <div class="edition-actions">
        <a class="btn btn-primary" href="/contact.html?subject=contribute">Ask to become an automatic contributor</a>
        <a class="btn btn-coral" href="mailto:coota@lovemallacoota.au?subject=For%20this%20week%27s%20edition">Email your piece instead</a>
      </div>
    </section>

    {edition ? (
      <section class="glass-card sheen content-block reveal">
        <form id="article-form" class="form-grid" method="post" action="/api/article" enctype="multipart/form-data">
          <input type="hidden" name="week" value={edition.week} />
          <div class="field">
            <label for="section">Section</label>
            <select id="section" name="section" required>
              {writable.map((section) => <option value={section.id}>{section.title}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="byline">Byline</label>
            <input id="byline" name="byline" type="text" placeholder="Your name, or your group" />
          </div>
          <div class="field">
            <label for="contact_email">Contact email</label>
            <input id="contact_email" name="contact_email" type="email" placeholder="Required if not signed in" />
          </div>
          <div class="field">
            <label for="contact_phone">Contact phone</label>
            <input id="contact_phone" name="contact_phone" type="tel" placeholder="Required if not signed in" />
          </div>
          <div class="field full">
            <label for="contact_public">
              <input id="contact_public" name="contact_public" type="checkbox" value="yes" />
              Publish these contact details with the piece
            </label>
            <p class="contact-hint">Leave unticked and they are kept for us to reach you, not shown to readers.</p>
          </div>
          <div class="field full">
            <label for="title">Headline</label>
            <input id="title" name="title" type="text" required maxlength="160" />
          </div>
          <div class="field full">
            <label for="body">The piece</label>
            <textarea id="body" name="body" rows="16" required placeholder="Leave a blank line between paragraphs."></textarea>
            <p class="contact-hint">
              Blank line between paragraphs. A single line break is kept, so a
              verse or an address stays as you set it out. A little formatting
              is allowed: <code>**bold**</code>, <code>*italic*</code>,
              <code>[words](https://example.com)</code>, lines beginning with
              <code>-</code> become a bullet list, and a line beginning
              <code>##</code> is a subheading. Curly quotes and dashes are
              printed plain. Anything else, including HTML, is shown as you typed it.
            </p>
          </div>

          {/* Photograph 1 */}
          <div class="field full">
            <label for="photo">Photograph 1 (optional)</label>
            <input id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp,image/heic" />
            <p class="contact-hint">Sent full size - we resize to 1920px and convert to WebP. Up to 12MB.</p>
          </div>
          <div class="field">
            <label for="caption">Photo 1 caption</label>
            <input id="caption" name="caption" type="text" maxlength="300" placeholder="What is happening in the picture" />
          </div>
          <div class="field">
            <label for="credit">Photo 1 credit</label>
            <input id="credit" name="credit" type="text" maxlength="300" placeholder="Who took it - required if photo attached" />
          </div>

          {/* Photograph 2 */}
          <div class="field full">
            <label for="photo2">Photograph 2 (optional)</label>
            <input id="photo2" name="photo2" type="file" accept="image/jpeg,image/png,image/webp,image/heic" />
          </div>
          <div class="field">
            <label for="caption2">Photo 2 caption</label>
            <input id="caption2" name="caption2" type="text" maxlength="300" placeholder="What is happening in the picture" />
          </div>
          <div class="field">
            <label for="credit2">Photo 2 credit</label>
            <input id="credit2" name="credit2" type="text" maxlength="300" placeholder="Who took it" />
          </div>

          {/* Photograph 3 */}
          <div class="field full">
            <label for="photo3">Photograph 3 (optional)</label>
            <input id="photo3" name="photo3" type="file" accept="image/jpeg,image/png,image/webp,image/heic" />
          </div>
          <div class="field">
            <label for="caption3">Photo 3 caption</label>
            <input id="caption3" name="caption3" type="text" maxlength="300" placeholder="What is happening in the picture" />
          </div>
          <div class="field">
            <label for="credit3">Photo 3 credit</label>
            <input id="credit3" name="credit3" type="text" maxlength="300" placeholder="Who took it" />
          </div>

          <div class="field full">
            <label for="as_cover">
              <input id="as_cover" name="as_cover" type="checkbox" value="yes" />
              Offer Photograph 1 as the cover photograph for the week
            </label>
            <p class="contact-hint">Cover photographs are portrait if possible, and print best at 2480 × 3508 or larger.</p>
          </div>

          <div class="form-actions full">
            <button class="btn btn-primary" type="submit" id="article-submit">Submit article</button>
            <a href="/edition.html" class="btn btn-ghost">See this week</a>
          </div>
        </form>
        <div id="article-status" class="form-status" role="status" aria-live="polite"></div>
      </section>
    ) : (
      <section class="glass-card sheen content-block reveal">
        <p class="no-results">No edition is open for submissions right now.</p>
      </section>
    )}

    <section class="glass-card sheen content-block reveal">
      <h2 class="section-title">How this works</h2>
      <p class="section-sub">Written down so there are no surprises.</p>
      <ul class="edition-diary">
        <li><strong>Contributors are recognised by their email address.</strong> There is no password and no account to create. If your browser is not signed in as a contributor, the form says so and tells you who to email.</li>
        <li><strong>It publishes itself.</strong> A piece that clears the <a href="/editorial-policy.html">editorial policy</a> goes live in about two minutes, without waiting for anyone.</li>
        <li><strong>Held is not rejected.</strong> Anything the check queries is kept and read by a person, who will tell you why.</li>
        <li><strong>Writing about someone?</strong> Ask them first. Profiles of named people run with their agreement.</li>
        <li><strong>Classifieds and family notices need a contact.</strong> A phone number or an email address, either written into the piece or in the contact fields with publishing ticked. Without one there is no way for a reader to answer it.</li>
        <li><strong>A photograph needs a credit.</strong> Who took it, always. Without one the words publish and the picture does not.</li>
        <li><strong>Corrections are visible.</strong> Every change is recorded, so a correction reads as a correction rather than a quiet edit.</li>
      </ul>
    </section>
    <section class="glass-card sheen content-block reveal">
      <div class="edition-actions">
        <a class="btn btn-primary" href="/edition.html">Return to this week's edition</a>
        <a class="btn btn-ghost" href="/archive.html#locals">Local of the Week</a>
        <a class="btn btn-ghost" href="/">Home</a>
      </div>
    </section>
  </main>
  <script slot="scripts" is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("article-form");
      const status = document.getElementById("article-status");
      const button = document.getElementById("article-submit");
      if (!form || !status || !button) return;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        button.disabled = true;
        const label = button.textContent;
        button.textContent = "Checking...";
        status.className = "form-status";

        try {
          const response = await fetch("/api/article", { method: "POST", body: new FormData(form) });
          const result = await response.json().catch(() => ({}));
          if (result.ok) {
            status.textContent = result.note || "Published.";
            status.className = "form-status success";
            form.reset();
          } else if (result.held) {
            status.textContent = `${result.error}${result.reason ? ` (${result.reason})` : ""}`;
            status.className = "form-status error";
          } else {
            status.textContent = result.error || "Something went wrong. Please try again.";
            status.className = "form-status error";
          }
        } catch {
          status.textContent = "Something went wrong. Please try again.";
          status.className = "form-status error";
        } finally {
          button.disabled = false;
          button.textContent = label;
        }
      });
    });
  </script>
</BaseLayout>
