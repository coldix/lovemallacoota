---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { articleAnchor, breadcrumbSchema, editionPath, localSchema, localsOfTheWeek } from "../lib/editions.mjs";
import { renderBody } from "../lib/markup.mjs";

const locals = localsOfTheWeek();
const schema = locals.map(localSchema);
const crumbs = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Local of the Week", path: "/locals.html" },
]);
---
<BaseLayout
  title="Local of the Week — Love Mallacoota"
  description="The people of Mallacoota and their stories — a new local featured every week."
  canonicalPath="/locals.html"
  active="locals"
  showAds={true}
  socialImage={locals[0]?.image?.url}
>
  {schema.map((entry) => <script slot="head" type="application/ld+json" set:html={JSON.stringify(entry)} is:inline />)}
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(crumbs)} is:inline />
  <PageHero eyebrow="The people here" prefix="Local of the" accent="Week" lede="Mallacoota is its people. Every week we publish one of their stories — what they did, where they came from, and what they know that the rest of us do not." />
  <main class="locals-page">
    {locals.length === 0 ? (
      <section class="glass-card sheen content-block reveal">
        <p class="no-results">The first Local of the Week is on its way.</p>
      </section>
    ) : (
      locals.map((local) => (
        <article class="glass-card sheen content-block reveal edition-article" id={articleAnchor(local)}>
          <p class="eyebrow">Week of {local.displayDate}</p>
          <h2>{local.title}</h2>
          {local.byline && <p class="edition-byline">{local.byline}</p>}
          {[local.image, ...(local.images || [])].filter(Boolean).map((image) => (
            <figure class="edition-figure">
              <img src={image.url} alt={image.alt} loading="lazy" decoding="async" />
              <figcaption>
                {image.credit}
                {image.note && <span> · {image.note}</span>}
              </figcaption>
            </figure>
          ))}
          <Fragment set:html={renderBody(local.body)} />
          {local.corrections?.length > 0 && (
            <aside class="edition-correction">
              <h4>Corrections</h4>
              <ul>
                {local.corrections.map((correction) => (
                  <li><time datetime={correction.date}>{correction.date}</time> — {correction.note}</li>
                ))}
              </ul>
            </aside>
          )}
          {local.sources?.length > 0 && (
            <p class="edition-source">
              Source: {local.sources.map((source) => `${source.title}, ${source.publication}, ${source.date}`).join("; ")}.
            </p>
          )}
          <p><a class="btn btn-ghost" href={editionPath({ week: local.week })}>That week's edition</a></p>
        </article>
      ))
    )}

    <section class="glass-card sheen content-block reveal">
      <h2 class="section-title">Know someone worth writing about?</h2>
      <p class="section-sub">Most people here have done something the rest of us have never heard about. Tell us who, and we will ask them.</p>
      <div class="edition-actions">
        <a class="btn btn-coral" href="/contact.html?subject=local">Suggest a local</a>
        <a class="btn btn-ghost" href="/edition.html">This week's edition</a>
      </div>
    </section>
  </main>
</BaseLayout>
