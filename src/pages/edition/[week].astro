---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import EditionBody from "../../components/EditionBody.astro";
import {
  breadcrumbSchema,
  editionLabel,
  editionSchema,
  editionTitle,
  loadEditions,
} from "../../lib/editions.mjs";

// One static page per edition, so every week keeps a permanent URL.
export function getStaticPaths() {
  return loadEditions().map((edition) => ({
    params: { week: edition.week },
    props: { edition },
  }));
}

const { edition } = Astro.props;
const schema = editionSchema(edition);
const crumbs = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "This Week", path: "/edition.html" },
  { name: editionLabel(edition), path: `/edition/${edition.week}.html` },
]);
---
<BaseLayout
  title={`${editionTitle(edition)} — This Week in Mallacoota`}
  description={`The Mallacoota weekly edition for the week of ${edition.displayDate}.`}
  canonicalPath={`/edition/${edition.week}.html`}
  active="edition"
  showAds={true}
  socialImage={edition.cover?.web}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(crumbs)} is:inline />
  <PageHero eyebrow="Weekly edition" prefix="Week of" accent={edition.displayDate} lede={`${editionLabel(edition)} — community notices, club and school news, events, weather and tides.`} />
  <main>
    <EditionBody edition={edition} archived={edition.status !== "open"} />
    <section class="glass-card sheen content-block reveal edition-web-only">
      <a class="btn btn-ghost" href="/edition.html">Back to this week</a>
    </section>
  </main>
</BaseLayout>
