---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found - Love Mallacoota" description="That page is not here. Search the Mallacoota directory, read this week's edition, or see what is on." canonicalPath="/404.html" robots="noindex" showSurvey={false}>
  <main>
    <section class="glass-card hero-section">
      <p class="eyebrow">404</p>
      <h1>That page has <span class="grad">moved on</span></h1>
      <p class="lede">The address may be old or mistyped. Start again from the community guide.</p>
      <a class="btn btn-primary" href="/">Return to Love Mallacoota</a>
    </section>
  </main>
</BaseLayout>
