---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { SECTIONS, SITE_ORIGIN, WHATS_ON, sectionCounts } from "../lib/directory.mjs";
import { currentEdition, editionLabel, panoramaOfTheWeek } from "../lib/editions.mjs";

// The weekly promotion and the panorama both follow the open edition.
const edition = currentEdition();
const panorama = edition ? panoramaOfTheWeek(edition.week) : null;

const counts = sectionCounts();
const eat = counts["eat-drink"];
const stay = counts.stay;
const community = counts.community;

const directoryCards = [
  { ...SECTIONS["eat-drink"], count: counts["eat-drink"], countLabel: "places to eat" },
  { ...SECTIONS.stay, count: counts.stay, countLabel: "places to stay" },
  { ...SECTIONS["do-see"], count: counts["do-see"], countLabel: "things to do" },
  { ...SECTIONS.community, count: counts.community, countLabel: "groups" },
  { ...SECTIONS.services, count: counts.services, countLabel: "services" },
  { ...WHATS_ON, count: null, countLabel: "calendar and this week" },
];

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  url: `${SITE_ORIGIN}/`,
  name: "Love Mallacoota",
  description:
    "Mallacoota's community directory — places to eat, stay and explore, plus clubs, services and what's on.",
};
---

<BaseLayout
  title="Love Mallacoota — Your Local Guide to Mallacoota"
  description="Mallacoota's community directory and local guide — eat, stay, do, clubs, services and what's on."
  canonicalPath="/"
  showAds={true}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(siteSchema)} is:inline />
  <PageHero
    prefix="Fall in love with"
    accent="Mallacoota"
    lede="Where the wilderness meets the sea. The town directory for residents and visitors — every place to eat, stay and explore, and the clubs, services and official contacts a remote town actually needs."
    logo={true}
  >
    <div class="hero-cta">
      <a href="/food.html" class="btn btn-primary">Eat &amp; Drink</a>
      <a href="/community.html" class="btn btn-coral">Community</a>
      <a href="/services.html" class="btn btn-ghost">Services</a>
    </div>
    <div class="stats-row" id="stats-row">
      <div class="stat"><b id="stat-food" data-count={eat}>{eat}</b><span>Places to eat</span></div>
      <div class="stat"><b id="stat-stay" data-count={stay}>{stay}</b><span>Places to stay</span></div>
      <div class="stat"><b id="stat-community" data-count={community}>{community}</b><span>Community groups</span></div>
    </div>
  </PageHero>

  <main>

<section class="glass-card sheen content-block platform-callout reveal" aria-labelledby="platform-title">
      <div>
        <p class="eyebrow">Add your listing — free</p>
        <h2 id="platform-title">Clubs, trades and services, in the same directory as the bakery</h2>
        <p>Love Mallacoota is the town directory, not only a visitor guide. A club secretary can add or claim a listing, confirm an email, and later update meeting times without anyone editing JSON by hand.</p>
      </div>
      <div class="platform-actions">
        <a class="btn btn-primary" href="/add-listing.html">Add your listing</a>
        <a class="btn btn-ghost" href="/directory.html">Search the directory</a>
      </div>
    </section>

    <section class="glass-card sheen content-block reveal">
      <h2 class="section-title">Explore Mallacoota</h2>
      <p class="section-sub">Visitor information and community information, side by side.</p>
      <div class="links-grid directory-home-grid">
        {directoryCards.map((card) => (
          <a href={card.href} class="link-card">
            <span class="arrow" aria-hidden="true">↗</span>
            <span class="emoji" aria-hidden="true">{card.emoji}</span>
            <h3>{card.label}</h3>
            <p>{card.blurb}</p>
            {card.count !== null && (
              <p class="directory-card-count">{card.count} {card.countLabel}</p>
            )}
          </a>
        ))}
      </div>
    </section>

    <section class="glass-card sheen content-block reveal edition-promo" aria-labelledby="this-week-title">
      <p class="eyebrow">Weekly edition{edition ? ` · ${editionLabel(edition)}` : ""}</p>
      <h2 id="this-week-title">This Week in <span class="grad">Mallacoota</span></h2>
      <p class="lede">
        Community notices, club and school news, the week's events, weather and
        tides — contributed by the people and groups they belong to.
      </p>
      <div class="hero-cta">
        <a href="/edition.html" class="btn btn-primary">Read this week</a>
        <a href="/locals.html" class="btn btn-coral">Local of the Week</a>
        <a href="/calendar.html" class="btn btn-ghost">Community calendar</a>
      </div>
    </section>

    <section class="glass-card sheen content-block reveal">
      <h2 class="section-title">Experience Mallacoota</h2>
      <p class="section-sub">Mornings on the inlet, from Mallacoota2020.</p>
      <div class="media-frame">
        <iframe src="https://www.youtube-nocookie.com/embed/BBLQz7ozibM" title="Experience Mallacoota — video" loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>

      {panorama && (
        <div class="panorama">
          <h3>Look around</h3>
          <p class="section-sub">
            A three-sixty view, changed each week — number {panorama.position} of {panorama.of}.
            Drag to look, or open it full screen.
          </p>
          <div class="media-frame">
            <iframe
              class="ku-embed"
              title="Three-sixty view around Mallacoota"
              frameborder="0"
              allow="xr-spatial-tracking; gyroscope; accelerometer"
              allowfullscreen
              scrolling="no"
              loading="lazy"
              src={`https://kuula.co/share/${panorama.id}?logo=1&info=0&fs=1&vr=1&zoom=1&autorotate=0.33&autopalt=1&thumbs=0`}
            ></iframe>
          </div>
        </div>
      )}
    </section>

    <section class="glass-card sheen content-block reveal" aria-label="Sponsored">
      <div class="ad-row-wrap"><div class="ad-row"><div class="ad-slot ad-300x250" data-ad-zone="in-content"></div><div class="ad-slot ad-300x250 ad-col-2" data-ad-zone="in-content-2"></div><div class="ad-slot ad-300x250 ad-col-3" data-ad-zone="in-content-3"></div></div></div>
    </section>

    <section class="glass-card sheen content-block reveal">
      <h2 class="section-title">Find Your Way</h2>
      <p class="section-sub">Roughly 520 km east of Melbourne, 550 km south of Sydney — and worth every kilometre.</p>
      <div class="media-frame"><iframe title="Map of Mallacoota" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=Mallacoota%20VIC%203892&z=13&output=embed"></iframe></div>
    </section>
  </main>
</BaseLayout>
