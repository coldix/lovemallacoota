---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { SECTIONS, SITE_ORIGIN, WHATS_ON, loadDirectory, sectionCounts } from "../lib/directory.mjs";
import { currentEdition, editionLabel, loadDataFile } from "../lib/editions.mjs";
import { CARDS } from "../lib/social.mjs";
import SupportSection from "../components/SupportSection.astro";

// The weekly promotion and the panorama both follow the open edition.
const edition = currentEdition();
const panoramas = loadDataFile("panoramas.json", null)?.views || [];

const counts = sectionCounts();
const eat = counts["eat-drink"];
const stay = counts.stay;
const community = counts.community;
const doSee = counts["do-see"];
const services = counts.services;

const directoryCards = [
  { ...SECTIONS["eat-drink"], count: counts["eat-drink"], countLabel: "places to eat" },
  { ...SECTIONS.stay, count: counts.stay, countLabel: "places to stay" },
  { ...SECTIONS["do-see"], count: counts["do-see"], countLabel: "things to do" },
  { ...SECTIONS.community, count: counts.community, countLabel: "groups" },
  { ...SECTIONS.services, count: counts.services, countLabel: "services" },
  { ...WHATS_ON, count: null, countLabel: "calendar and this week" },
];

const listingCount = loadDirectory().length;

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  url: `${SITE_ORIGIN}/`,
  name: "Love Mallacoota",
  inLanguage: "en-AU",
  description:
    "Mallacoota's community directory - places to eat, stay and explore, plus clubs, services and what's on.",
  publisher: { "@id": `${SITE_ORIGIN}/#publisher` },
};

/**
 * Who publishes this. Named once, on the home page, so a search or answer
 * engine can attribute the rest of the site to a real person in a real place
 * rather than to an anonymous domain.
 */
const publisherSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE_ORIGIN}/#publisher`,
  name: "Love Mallacoota",
  url: `${SITE_ORIGIN}/`,
  logo: `${SITE_ORIGIN}/images/logo.png`,
  founder: { "@type": "Person", name: "Colin Dixon" },
  areaServed: {
    "@type": "Place",
    name: "Mallacoota, Victoria 3892, Australia",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Mallacoota",
      addressRegion: "VIC",
      postalCode: "3892",
      addressCountry: "AU",
    },
  },
  parentOrganization: { "@type": "Organization", name: "Oze", url: "https://oze.au" },
  sameAs: [
    "https://www.facebook.com/lovemallacoota",
    "https://www.instagram.com/lovemallacoota",
    "https://www.youtube.com/@mallacoota2020",
  ],
};
---

<BaseLayout
  title="Mallacoota - what's on, and where to find things"
  description={`Mallacoota, Victoria: this week's community edition, what's on, and ${listingCount} listings for places to eat, stay and visit, plus clubs, trades and official services.`}
  canonicalPath="/"
  showAds={true}
  socialImage={CARDS.home}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(siteSchema)} is:inline />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(publisherSchema)} is:inline />
  <PageHero
    prefix="Fall in love with"
    accent="Mallacoota"
    lede="Where the wilderness meets the sea. The town directory for residents and visitors - every place to eat, stay and explore, and the clubs, services and official contacts a remote town actually needs."
    logo={true}
  >
    <div class="hero-cta">
      <a href="/edition.html" class="btn btn-primary">This Week</a>
      <a href="/calendar.html" class="btn btn-coral">What's On</a>
      <a href="/food.html" class="btn btn-ghost">Eat &amp; Drink</a>
      <a href="/accom.html" class="btn btn-ghost">Stay</a>
    </div>
    <div class="stats-row" id="stats-row">
      <div class="stat"><b id="stat-total" data-count={listingCount}>{listingCount}</b><span>Total listings</span></div>
      <div class="stat"><b id="stat-food" data-count={eat}>{eat}</b><span>Places to eat</span></div>
      <div class="stat"><b id="stat-stay" data-count={stay}>{stay}</b><span>Places to stay</span></div>
      <div class="stat"><b id="stat-do" data-count={doSee}>{doSee}</b><span>Things to do</span></div>
      <div class="stat"><b id="stat-community" data-count={community}>{community}</b><span>Community groups</span></div>
      <div class="stat"><b id="stat-services" data-count={services}>{services}</b><span>Local services</span></div>
    </div>
  </PageHero>

  <main>

    <section class="glass-card sheen content-block reveal edition-promo" aria-labelledby="this-week-title">
      <p class="eyebrow">Weekly edition{edition ? ` · ${editionLabel(edition)}` : ""}</p>
      <h2 id="this-week-title">This Week in <span class="grad">Mallacoota</span></h2>
      <p class="lede">
        Community notices, club and school news, the week's events, weather and
        tides - contributed by the people and groups they belong to.
      </p>
      <div class="hero-cta">
        <a href="/edition.html" class="btn btn-primary">Read this week</a>
        <a href="/calendar.html" class="btn btn-coral">What's On</a>
        <a href="/archive.html" class="btn btn-ghost">Past editions</a>
      </div>
    </section>

    <section class="glass-card sheen content-block reveal">
      <h2 class="section-title">Explore Mallacoota</h2>
      <p class="section-sub">Visitor information and community information, side by side.</p>
      <div class="links-grid directory-home-grid">
        {directoryCards.map((card) => (
          <a href={card.href} class="link-card">
            <span class="arrow" aria-hidden="true">↗</span>
            <span class="emoji" aria-hidden="true">{card.emoji}</span>
            <h3>{card.label}</h3>
            <p>{card.blurb}</p>
            {card.count !== null && (
              <p class="directory-card-count">{card.count} {card.countLabel}</p>
            )}
          </a>
        ))}
      </div>
    </section>

    <section class="glass-card sheen content-block platform-callout reveal" aria-labelledby="platform-title">
      <div>
        <p class="eyebrow">Add your listing - free</p>
        <h2 id="platform-title">Clubs, trades and services, in the same directory as the bakery</h2>
        <p>Love Mallacoota is the town directory, not only a visitor guide. A club secretary can add or claim a listing, confirm it by email, and update meeting times whenever they change - without asking anyone, and without an account.</p>
      </div>
      <div class="platform-actions">
        <a class="btn btn-primary" href="/add-listing.html">Add your listing</a>
        <a class="btn btn-ghost" href="/directory.html">Search the directory</a>
      </div>
    </section>

    <SupportSection />

    <section class="glass-card sheen content-block reveal">
      <h2 class="section-title">Experience Mallacoota</h2>
      <p class="section-sub">Mornings on the inlet, from Mallacoota2020.</p>
      <div class="media-frame">
        <iframe src="https://www.youtube-nocookie.com/embed/BBLQz7ozibM" title="Experience Mallacoota - video" loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>

      {panoramas.length > 0 && (
        <div class="panorama">
          <h3>360° around Mallacoota</h3>
          <p class="section-sub">Pick a view, then drag to look around - or open it full screen.</p>
          <div class="tag-row" id="panorama-picker" role="group" aria-label="Choose a 360 degree view">
            {panoramas.map((view, index) => (
              <button
                type="button"
                class:list={["tag-btn", { active: index === 0 }]}
                data-panorama={view.id}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                360° · {index + 1}
              </button>
            ))}
          </div>
          <div class="media-frame">
            <iframe
              id="panorama-frame"
              class="ku-embed"
              title="Three-sixty view around Mallacoota"
              frameborder="0"
              allow="xr-spatial-tracking; gyroscope; accelerometer"
              allowfullscreen
              scrolling="no"
              loading="lazy"
              src={`https://kuula.co/share/${panoramas[0].id}?logo=1&info=0&fs=1&vr=1&zoom=1&autorotate=0.33&autopalt=1&thumbs=0`}
            ></iframe>
          </div>
        </div>
      )}
    </section>

    <section class="glass-card sheen content-block reveal" aria-label="Sponsored">
      <div class="ad-row-wrap"><div class="ad-row"><div class="ad-slot ad-300x250" data-ad-zone="in-content"></div><div class="ad-slot ad-300x250 ad-col-2" data-ad-zone="in-content-2"></div><div class="ad-slot ad-300x250 ad-col-3" data-ad-zone="in-content-3"></div></div></div>
    </section>

    <section class="glass-card sheen content-block reveal">
      <h2 class="section-title">Find Your Way</h2>
      <p class="section-sub">Roughly 520 km east of Melbourne, 550 km south of Sydney - and worth every kilometre.</p>
      <div class="media-frame"><iframe title="Map of Mallacoota" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=Mallacoota%20VIC%203892&z=13&t=h&output=embed"></iframe></div>
    </section>
  </main>
</BaseLayout>
